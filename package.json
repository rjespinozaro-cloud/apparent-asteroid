{
  "name": "joanix-guides",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:migrate": "wrangler d1 migrations apply ciberguias --local",
    "db:migrate:remote": "wrangler d1 migrations apply ciberguias --remote",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "marked": "^18.0.14",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "description": "Plataforma de guías de ciberseguridad RED y BLUE sobre Astro + Cloudflare Workers + D1",
  "private": true,
  "devDependencies": {}
}
