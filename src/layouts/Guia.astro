---
import Base from './Base.astro';
import Candado from '../components/Candado.astro';
import Migas from '../components/Migas.astro';
import { precioGuia } from '../lib/pago.js';
import { tiendaActiva } from '../lib/tienda.js';
import { env } from 'cloudflare:workers';
import '../styles/guia.css';

interface Props {
  /** Slug de la guía, para el flujo de compra. */
  slug?: string;
  titulo: string;
  herramienta: string;
  /** Slug legible de la herramienta, para las migas. */
  herramientaSlug?: string;
  equipo: 'blue' | 'red';
  nivel: string;
  acceso: string;
  enlaceCompra?: string | null;
  precioCentimos?: number | null;
  moneda?: string;
  pasarela?: 'stripe' | 'lemonsqueezy' | 'polar' | 'manual' | null;
  /** Títulos reales de las secciones que quedan tras el corte (solo pago). */
  restoTitulos?: string[];
  descripcion?: string;
  fecha?: string;
  tiempoLectura?: number;
  indice?: Array<{ id: string; texto: string; nivel?: number }>;
  /** Datos estructurados de la guía (JSON-LD). */
  jsonLd?: Record<string, unknown>;
  /** Ficha de producto para guías de pago con precio (JSON-LD). */
  jsonLdProducto?: Record<string, unknown>;
  noindex?: boolean;
}

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const {
  slug = '',
  titulo,
  herramienta,
  herramientaSlug = herramienta,
  equipo,
  nivel,
  acceso,
  enlaceCompra = null,
  precioCentimos = null,
  moneda = 'EUR',
  pasarela = null,
  restoTitulos = [],
  descripcion,
  fecha,
  tiempoLectura,
  indice = [],
  jsonLd,
  jsonLdProducto,
  noindex = false,
} = Astro.props;

/** Con la tienda apagada la ficha no anuncia precio ni producto comprable. */
const compraVisible = tiendaActiva(env);
const precio = compraVisible ? precioGuia(precioCentimos, moneda) : null;
---

<Base
  title={`${titulo} | JOANIX`}
  description={descripcion ?? `Guía de ${herramienta} para el equipo ${equipo === 'blue' ? 'BLUE (defensa)' : 'RED (ofensiva)'}, nivel ${nivel}.`}
  ogType="article"
  noindex={noindex}
>
  {jsonLd && (
    <script type="application/ld+json" slot="cabecera" set:html={JSON.stringify(jsonLd)} />
  )}
  {jsonLdProducto && (
    <script type="application/ld+json" slot="cabecera" set:html={JSON.stringify(jsonLdProducto)} />
  )}

  <article class:list={['guia', `guia--${equipo}`, 'contenedor']}>
    <header class="guia__cabecera">
      <Migas
        clase=""
        items={[
          { texto: 'Inicio', href: `${base}inicio/` },
          { texto: 'Guías', href: `${base}guias/` },
          { texto: herramienta, href: `${base}herramientas/${herramientaSlug}/` },
          { texto: titulo },
        ]}
      />

      <p class="guia__equipo-linea">
        <strong>{equipo === 'blue' ? 'BLUE · Defensa' : 'RED · Ofensiva'}</strong>
        <span aria-hidden="true"> · </span>
        <span>
          {acceso === 'pago'
            ? (compraVisible
              ? `Premium · PDF de pago${precio ? ` · ${precio}` : ''}`
              : 'Vista previa · versión completa no disponible')
            : 'Gratis · Lectura completa'}
        </span>
      </p>
      <h1>{titulo}</h1>

      {descripcion && <p class="entradilla">{descripcion}</p>}

      <ul class="guia__etiquetas" aria-label="Características de la guía">
        <li><span class:list={['etiqueta', `etiqueta--${equipo}`]}>{equipo === 'blue' ? 'BLUE' : 'RED'}</span></li>
        <li><span class="etiqueta etiqueta--neutro">{nivel}</span></li>
        <li><span class="etiqueta etiqueta--neutro">{herramienta}</span></li>
        {fecha && <li><time class="etiqueta etiqueta--neutro" datetime={fecha}>{fecha}</time></li>}
        {tiempoLectura && <li><span class="etiqueta etiqueta--neutro">{acceso === 'pago' ? (compraVisible ? `Vista previa · PDF completo, ~${tiempoLectura} min` : `Vista previa · ~${tiempoLectura} min`) : `${tiempoLectura} min de lectura`}</span></li>}
      </ul>

      <p class="guia__aviso">
        Material educativo. Ejecuta los comandos solo en tu laboratorio o en sistemas para los que tengas autorización expresa.
      </p>

      <slot name="acciones" />
    </header>

    <div class="guia__cuerpo">
      {indice.length > 0 && (
        <details class="guia__indice" open>
          <summary class="guia__indice-titulo" id="indice-titulo">En esta guía</summary>
          <ol aria-labelledby="indice-titulo">
            {indice.map((item) => (
              <li class:list={['guia__indice-item', item.nivel === 3 && 'guia__indice-item--sub']}>
                <a href={`#${item.id}`}>{item.texto}</a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <script>
        import '../scripts/guia-indice.js';
      </script>

      <div class="guia__contenido">
        <slot />
        {acceso === 'pago' && (
          <Candado
            slug={slug}
            enlaceCompra={enlaceCompra}
            incluye={restoTitulos}
            equipo={equipo}
            precioCentimos={precioCentimos}
            moneda={moneda}
            pasarela={pasarela}
          />
        )}
      </div>
    </div>
  </article>

  <slot name="pie" />
</Base>