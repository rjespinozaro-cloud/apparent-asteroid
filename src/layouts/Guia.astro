---
import Base from './Base.astro';
import Candado from '../components/Candado.astro';
import '../styles/guia.css';

interface Props {
  titulo: string;
  herramienta: string;
  /** Slug legible de la herramienta, para las migas. */
  herramientaSlug?: string;
  equipo: 'blue' | 'red';
  nivel: string;
  acceso: string;
  enlaceCompra?: string | null;
  /** Títulos reales de las secciones que quedan tras el corte (solo pago). */
  restoTitulos?: string[];
  descripcion?: string;
  fecha?: string;
  tiempoLectura?: number;
  indice?: Array<{ id: string; texto: string; nivel?: number }>;
  /** Datos estructurados de la guía (JSON-LD). */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const {
  titulo,
  herramienta,
  herramientaSlug = herramienta,
  equipo,
  nivel,
  acceso,
  enlaceCompra = null,
  restoTitulos = [],
  descripcion,
  fecha,
  tiempoLectura,
  indice = [],
  jsonLd,
  noindex = false,
} = Astro.props;
---

<Base
  title={`${titulo} | JOANIX GUIDES`}
  description={descripcion ?? `Guía de ${herramienta} para el equipo ${equipo === 'blue' ? 'BLUE (defensa)' : 'RED (ofensiva)'}, nivel ${nivel}.`}
  ogType="article"
  noindex={noindex}
>
  {jsonLd && (
    <script type="application/ld+json" slot="cabecera" set:html={JSON.stringify(jsonLd)} />
  )}

  <article class:list={['guia', `guia--${equipo}`]}>
    <header class="guia__cabecera">
      <nav aria-label="Migas de pan">
        <ol class="migas">
          <li><a href={`${base}inicio/`}>Inicio</a></li>
          <li><a href={`${base}guias/`}>Guías</a></li>
          <li><a href={`${base}herramientas/${herramientaSlug}/`}>{herramienta}</a></li>
          <li aria-current="page">{titulo}</li>
        </ol>
      </nav>

      <p class="guia__equipo-linea">
        <strong>{equipo === 'blue' ? 'BLUE · Defensa' : 'RED · Ofensiva'}</strong>
        <span aria-hidden="true"> · </span>
        <span>{acceso === 'pago' ? 'Premium · PDF de pago' : 'Gratis · Lectura completa'}</span>
      </p>
      <h1>{titulo}</h1>

      {descripcion && <p class="entradilla">{descripcion}</p>}

      <ul class="guia__etiquetas" aria-label="Características de la guía">
        <li><span class:list={['etiqueta', `etiqueta--${equipo}`]}>{equipo === 'blue' ? 'BLUE' : 'RED'}</span></li>
        <li><span class="etiqueta etiqueta--neutro">{nivel}</span></li>
        <li><span class="etiqueta etiqueta--neutro">{herramienta}</span></li>
        {fecha && <li><time class="etiqueta etiqueta--neutro" datetime={fecha}>{fecha}</time></li>}
        {tiempoLectura && <li><span class="etiqueta etiqueta--neutro">{tiempoLectura} min de lectura</span></li>}
      </ul>

      <p class="guia__aviso">
        Material educativo. Ejecuta los comandos solo en tu laboratorio o en sistemas para los que tengas autorización expresa.
      </p>
    </header>

    <div class="guia__cuerpo">
      {indice.length > 0 && (
        <details class="guia__indice" open>
          <summary class="guia__indice-titulo" id="indice-titulo">En esta guía</summary>
          <ol aria-labelledby="indice-titulo">
            {indice.map((item) => (
              <li class:list={['guia__indice-item', item.nivel === 3 && 'guia__indice-item--sub']}>
                <a href={`#${item.id}`}>{item.texto}</a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <script>
        import '../scripts/guia-indice.js';
      </script>

      <div class="guia__contenido">
        <slot />
        {acceso === 'pago' && <Candado enlaceCompra={enlaceCompra} incluye={restoTitulos} equipo={equipo} />}
      </div>
    </div>
  </article>

  <slot name="pie" />
</Base>