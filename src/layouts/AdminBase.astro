---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/admin-tokens.css';
import '../styles/admin.css';

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  crumbs?: Crumb[];
}

const {
  title = 'Administración | JOANIX GUIDES',
  description = 'Panel privado de administración de JOANIX GUIDES.',
  pageTitle = '',
  crumbs = [],
} = Astro.props;
const sesion = Astro.locals.admin;
const esAdmin = sesion?.usuario.rol === 'admin';

const navItems = [
  { href: '/admin/', label: 'Resumen', icon: 'home', exact: true },
  { href: '/admin/guias/', label: 'Guías', icon: 'documents' },
  { href: '/admin/guia-nueva/', label: 'Nueva guía', icon: 'plus' },
  ...(esAdmin ? [
    { href: '/admin/usuarios/', label: 'Usuarios', icon: 'users' },
    { href: '/admin/auditoria/', label: 'Auditoría', icon: 'audit' },
    { href: '/admin/ajustes-ia/', label: 'Ajustes IA', icon: 'settings' },
  ] : []),
];

function isActive(href: string, exact?: boolean) {
  if (exact) return Astro.url.pathname === href;
  return Astro.url.pathname === href || Astro.url.pathname.startsWith(href);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body class="admin">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <button
      class="admin-drawer-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="admin-sidebar"
      aria-label="Abrir menú de navegación"
      hidden
    >
      <svg class="admin-drawer-toggle__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <nav id="admin-sidebar" class="admin-sidebar" aria-label="Navegación principal del panel">
      <div class="admin-sidebar__header">
        <a class="admin-sidebar__marca" href="/admin/">
          <img class="admin-sidebar__logo" src="/logo.png" alt="JOANIX GUIDES" width="120" height="60" loading="lazy" decoding="async" />
        </a>
      </div>
      <ul class="admin-sidebar__nav" role="list">
        {navItems.map((item) => (
          <li>
            <a
              class:list={[
                'admin-sidebar__link',
                isActive(item.href, item.exact) ? 'admin-sidebar__link--active' : '',
              ]}
              href={item.href}
              aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
            >
              <span class="admin-sidebar__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {item.icon === 'home' && <><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></>}
                  {item.icon === 'documents' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></>}
                  {item.icon === 'plus' && <><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" /></>}
                  {item.icon === 'users' && <><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></>}
                  {item.icon === 'audit' && <path d="M22 12h-4l-3 9L9 3l-3 9H2" />}
                  {item.icon === 'settings' && <><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" /></>}
                </svg>
              </span>
              <span class="admin-sidebar__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="admin-sidebar__footer">
        <a class="admin-sidebar__portal" href="/inicio/" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          <span>Ver portal</span>
        </a>
      </div>
    </nav>

    <div class="admin-overlay" aria-hidden="true" hidden></div>

    <header class="admin-topbar">
      <div class="admin-topbar__start">
        {pageTitle && <p class="admin-topbar__title" aria-hidden="true">{pageTitle}</p>}
        {crumbs.length > 0 && (
          <nav class="admin-topbar__migas" aria-label="Migas de pan">
            <ol class="admin-migas">
              {crumbs.map((crumb) => (
                <li>
                  {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
      </div>
      <div class="admin-topbar__end">
        {sesion && (
          <div class="admin-topbar__usuario">
            <span class="admin-topbar__usuario-nombre">{sesion.usuario.usuario}</span>
            <span class="admin-topbar__usuario-rol">{sesion.usuario.rol}</span>
            <form class="admin-topbar__salir" method="post" action="/api/admin/logout">
              <input type="hidden" name="_csrf" value={sesion.csrf} />
              <button type="submit" class="admin-boton admin-boton--plano">Cerrar sesión</button>
            </form>
          </div>
        )}
      </div>
    </header>

    <main class="admin-main" id="contenido">
      <slot />
    </main>

    <script>
      import '../scripts/admin-drawer.js';
    </script>
  </body>
</html>
