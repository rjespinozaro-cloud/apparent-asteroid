---
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/admin.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Administración | JOANIX GUIDES', description = 'Panel privado de administración de JOANIX GUIDES.' } = Astro.props;
const sesion = Astro.locals.admin;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body class="admin">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="admin-topbar">
      <a class="admin-topbar__marca" href="/admin/">
        <img class="marca__logo" src="/logo.png" alt="JOANIX GUIDES" width="120" height="60" loading="lazy" decoding="async" />
        <span class="wordmark-glitch" data-text="JOANIX GUIDES">JOANIX GUIDES</span>
      </a>
      <div class="admin-topbar__sesion">
        {sesion && <span class="admin-topbar__usuario">{sesion.usuario.usuario} · {sesion.usuario.rol}</span>}
        <a class="admin-topbar__enlace" href="/">Ver portal</a>
        {sesion && (
          <form class="admin-topbar__salir" method="post" action="/api/admin/logout">
            <input type="hidden" name="_csrf" value={sesion.csrf} />
            <button type="submit">Cerrar sesión</button>
          </form>
        )}
      </div>
    </header>

    <main class="site-main admin-shell" id="contenido">
      <slot />
    </main>
  </body>
</html>