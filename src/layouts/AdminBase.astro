---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/admin-tokens.css';
import '../styles/admin.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Administración | JOANIX GUIDES', description = 'Panel privado de administración de JOANIX GUIDES.' } = Astro.props;
const sesion = Astro.locals.admin;
const esAdmin = sesion?.usuario.rol === 'admin';

const navItems = [
  { href: '/admin/', label: 'Resumen', icon: 'home', exact: true },
  { href: '/admin/guias/', label: 'Guías', icon: 'documents' },
  { href: '/admin/guia-nueva/', label: 'Nueva guía', icon: 'plus' },
  ...(esAdmin ? [
    { href: '/admin/usuarios/', label: 'Usuarios', icon: 'users' },
    { href: '/admin/auditoria/', label: 'Auditoría', icon: 'audit' },
    { href: '/admin/ajustes-ia/', label: 'Ajustes IA', icon: 'settings' },
  ] : []),
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body class="admin">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <button
      class="admin-drawer-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="admin-sidebar"
      aria-label="Abrir menú de navegación"
      hidden
    >
      <svg class="admin-drawer-toggle__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <nav id="admin-sidebar" class="admin-sidebar" aria-label="Navegación principal del panel">
      <div class="admin-sidebar__header">
        <a class="admin-sidebar__marca" href="/admin/">
          <img class="admin-sidebar__logo" src="/logo.png" alt="JOANIX GUIDES" width="120" height="60" loading="lazy" decoding="async" />
        </a>
      </div>
      <ul class="admin-sidebar__nav" role="list">
        {navItems.map((item) => (
          <li>
            <a
              class:list={[
                'admin-sidebar__link',
                (Astro.url.pathname === item.href || (item.exact ? false : Astro.url.pathname.startsWith(item.href))) ? 'admin-sidebar__link--active' : '',
              ]}
              href={item.href}
              aria-current={(Astro.url.pathname === item.href || (item.exact ? false : Astro.url.pathname.startsWith(item.href))) ? 'page' : undefined}
            >
              <span class="admin-sidebar__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {item.icon === 'home' && <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" />}
                  {item.icon === 'documents' && <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" />}
                  {item.icon === 'plus' && <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" />}
                  {item.icon === 'users' && <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />}
                  {item.icon === 'audit' && <path d="M22 12h-4l-3 9L9 3l-3 9H2" />}
                  {item.icon === 'settings' && <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 1 4.6 9a1.65 1.65 0 0 1 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 1-.33 1.82V9a1.65 1.65 0 0 1 1.51-1H9a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 1 1 1.51 1.65 1.65 0 0 1 1.82.33l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 1-.33-1.82V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 1 1 1.51 1.65 1.65 0 0 1 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0-2.83l-.06-.06A1.65 1.65 0 0 1 15 4.6 1.65 1.65 0 0 1 16.5 3H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />}
                </svg>
              </span>
              <span class="admin-sidebar__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="admin-sidebar__footer">
        <a class="admin-sidebar__portal" href="/" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          <span>Ver portal</span>
        </a>
      </div>
    </nav>

    <div class="admin-overlay" aria-hidden="true" hidden></div>

    <header class="admin-topbar">
      <div class="admin-topbar__start">
        <h1 class="admin-topbar__title">
          <slot name="page-title" />
        </h1>
        <nav class="admin-topbar__migas" aria-label="Migas de pan" slot="breadcrumbs">
          <ol class="admin-migas">
            <li><a href="/admin/">Resumen</a></li>
            <li slot="breadcrumb" />
          </ol>
        </nav>
      </div>
      <div class="admin-topbar__end">
        {sesion && (
          <div class="admin-topbar__usuario">
            <span class="admin-topbar__usuario-nombre">{sesion.usuario.usuario}</span>
            <span class="admin-topbar__usuario-rol">{sesion.usuario.rol}</span>
            <form class="admin-topbar__salir" method="post" action="/api/admin/logout">
              <input type="hidden" name="_csrf" value={sesion.csrf} />
              <button type="submit" class="admin-boton admin-boton--plano">Cerrar sesión</button>
            </form>
          </div>
        )}
      </div>
    </header>

    <main class="admin-main" id="contenido">
      <slot />
    </main>

    <script>
      // Mobile sidebar drawer
      const toggle = document.querySelector('.admin-drawer-toggle');
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.querySelector('.admin-overlay');

      if (toggle && sidebar && overlay) {
        const open = () => {
          sidebar.classList.add('admin-sidebar--open');
          overlay.hidden = false;
          toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        const close = () => {
          sidebar.classList.remove('admin-sidebar--open');
          overlay.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        toggle.addEventListener('click', () => {
          if (sidebar.classList.contains('admin-sidebar--open')) {
            close();
          } else {
            open();
          }
        });

        overlay.addEventListener('click', close);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sidebar.classList.contains('admin-sidebar--open')) {
            close();
          }
        });

        // Trap focus in sidebar when open
        const focusableElements = sidebar.querySelectorAll('a, button');
        const firstFocusable = focusableElements[0];
        const lastFocusable = focusableElements[focusableElements.length - 1];

        sidebar.addEventListener('keydown', (e) => {
          if (!sidebar.classList.contains('admin-sidebar--open')) return;
          if (e.key !== 'Tab') return;

          if (e.shiftKey) {
            if (document.activeElement === firstFocusable) {
              e.preventDefault();
              lastFocusable.focus();
            }
          } else {
            if (document.activeElement === lastFocusable) {
              e.preventDefault();
              firstFocusable.focus();
            }
          }
        });
      }

      // Show/hide drawer toggle based on viewport
      const mq = window.matchMedia('(max-width: 1023px)');
      const updateToggle = () => {
        if (toggle && sidebar) {
          if (mq.matches) {
            toggle.hidden = false;
            sidebar.classList.add('admin-sidebar--drawer');
          } else {
            toggle.hidden = true;
            sidebar.classList.remove('admin-sidebar--drawer');
            sidebar.classList.remove('admin-sidebar--open');
            overlay.hidden = true;
            document.body.style.overflow = '';
          }
        }
      };
      mq.addEventListener('change', updateToggle);
      updateToggle();
    </script>
  </body>
</html>