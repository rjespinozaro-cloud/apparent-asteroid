---
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/motion.css';
import '../styles/guias-listado.css';
import '../styles/inicio.css';
import Menu from '../components/Menu.astro';
import AvisoLegal from '../components/AvisoLegal.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Clase extra del elemento <main>, para páginas con ancho completo. */
  clase?: string;
}

// BASE_URL trae el subpath en modo Pages ('/apparent-asteroid') y '/' en
// Cloudflare: se normaliza para prefijar assets sin romper ningún modo.
const baseAsset = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const {
  title = 'JOANIX GUIDES | Guías de ciberseguridad RED y BLUE',
  description = 'Guías prácticas de hacking ético y redes para equipos RED y BLUE: reconocimiento, análisis y defensa con herramientas reales.',
  ogImage = `${baseAsset}og-image.png`,
  ogType = 'website',
  noindex = false,
  clase,
} = Astro.props;

const origen = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origen).href;
const imagenOg = new URL(ogImage, origen).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseAsset}favicon-32.png`} />
    <link rel="icon" href={`${baseAsset}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${baseAsset}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${baseAsset}sitemap.xml`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="JOANIX GUIDES" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JOANIX GUIDES, guías de ciberseguridad RED y BLUE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />
    <title>{title}</title>
    <slot name="cabecera" />
  </head>
  <body>
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="cabecera__interna contenedor">
        <a class="marca" href={`${baseAsset}inicio/`} aria-label="JOANIX GUIDES, inicio">
          <img class="marca__logo" src={`${baseAsset}logo.png`} alt="JOANIX GUIDES" width="180" height="90" fetchpriority="high" loading="lazy" decoding="async" />
        </a>
        <Menu ruta={Astro.url.pathname} />
      </div>
    </header>

    <main class="site-main" id="contenido">
      <div class:list={['site-main__interior', clase]}>
        <slot />
      </div>
    </main>

    <footer class="pie">
      <div class="pie__interna contenedor">
        <div class="pie__marca">
          <p class="pie__nombre">JOANIX GUIDES</p>
          <p class="pie__lema">Cybersecurity Knowledge Lab</p>
        </div>
        <nav class="pie__nav" aria-label="Navegación del pie">
          <a href={`${baseAsset}guias/`}>Guías</a>
          <a href={`${baseAsset}herramientas/`}>Herramientas</a>
          <a href={`${baseAsset}guias/?equipo=red`}>RED</a>
          <a href={`${baseAsset}guias/?equipo=blue`}>BLUE</a>
        </nav>
        <AvisoLegal />
      </div>
    </footer>

    <!-- Reading progress bar -->
    <div class="progreso-lectura" aria-hidden="true"></div>

    <script>
      import '../scripts/copiar-codigo.js';
    </script>
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>