---
import { markdownAHtml } from '../../lib/markdown.js';

type FilaGuia = {
  id?: number;
  slug?: string;
  titulo?: string;
  herramienta?: string;
  equipo?: 'blue' | 'red';
  nivel?: string;
  acceso?: 'gratis' | 'pago';
  enlace_compra?: string | null;
  guia_pareja?: string | null;
  fecha?: string;
  cuerpo_md?: string;
  publicada?: number;
  destacada?: number;
};

interface Props {
  guia?: FilaGuia | null;
  csrf: string;
  endpoint: string;
  metodo: 'POST' | 'PUT';
  esAdmin: boolean;
  herramientas: string[];
  today: string;
  asistente?: boolean;
}

const { guia = null, csrf, endpoint, metodo, esAdmin, herramientas, today, asistente = false } = Astro.props;
const equipo = guia?.equipo ?? 'blue';
const acceso = guia?.acceso ?? 'gratis';
const cuerpoMd = guia?.cuerpo_md ?? '';
const htmlInicial = markdownAHtml(cuerpoMd);
const tieneId = guia?.id !== undefined && guia?.id !== null;
---

<form
  class="admin-editor"
  data-editor
  data-endpoint={endpoint}
  data-metodo={metodo}
  data-preview="/api/admin/guias/preview"
  data-asistente={asistente ? '/api/admin/ia/asistir' : null}
>
  <input type="hidden" name="_csrf" value={csrf} />

  <div class="admin-editor__estado" role="status" data-mensaje hidden></div>

  <section class="admin-panel">
    <header class="admin-panel__header">
      <h2 class="admin-panel__titulo">Metadatos</h2>
    </header>
    <div class="admin-panel__body admin-rejilla">
      <div class="admin-form__campo">
        <label for="titulo">Título</label>
        <input id="titulo" name="titulo" type="text" required maxlength="160" value={guia?.titulo ?? ''} />
      </div>
      <div class="admin-form__campo">
        <label for="slug">Slug</label>
        <input id="slug" name="slug" type="text" required maxlength="160" placeholder="blue/nmap-basico" value={guia?.slug ?? ''} />
      </div>
      <div class="admin-form__campo">
        <label for="herramienta">Herramienta</label>
        <input id="herramienta" name="herramienta" type="text" required list="admin-herramientas" value={guia?.herramienta ?? ''} />
        <datalist id="admin-herramientas">
          {herramientas.map((nombre) => <option value={nombre} />)}
        </datalist>
      </div>
      <div class="admin-form__campo">
        <label for="fecha">Fecha</label>
        <input id="fecha" name="fecha" type="date" required value={guia?.fecha ?? today} />
      </div>
      <div class="admin-form__campo">
        <label for="equipo">Equipo</label>
        <select id="equipo" name="equipo">
          <option value="blue" selected={equipo === 'blue'}>BLUE</option>
          <option value="red" selected={equipo === 'red'}>RED</option>
        </select>
      </div>
      <div class="admin-form__campo">
        <label for="nivel">Nivel</label>
        <select id="nivel" name="nivel">
          <option value="basico" selected={(guia?.nivel ?? 'basico') === 'basico'}>Básico</option>
          <option value="intermedio" selected={guia?.nivel === 'intermedio'}>Intermedio</option>
          <option value="avanzado" selected={guia?.nivel === 'avanzado'}>Avanzado</option>
        </select>
      </div>
      <div class="admin-form__campo">
        <label for="acceso">Acceso</label>
        <select id="acceso" name="acceso">
          <option value="gratis" selected={acceso === 'gratis'}>Gratis</option>
          <option value="pago" selected={acceso === 'pago'}>Pago</option>
        </select>
      </div>
      <div class="admin-form__campo">
        <label for="enlaceCompra">Enlace de compra</label>
        <input id="enlaceCompra" name="enlaceCompra" type="url" placeholder="https://" value={guia?.enlace_compra ?? ''} />
      </div>
      <div class="admin-form__campo">
        <label for="guiaPareja">Guía pareja</label>
        <input id="guiaPareja" name="guiaPareja" type="text" placeholder="red/nmap-basico" value={guia?.guia_pareja ?? ''} />
      </div>
      <div class="admin-form__campo admin-form__campo--check">
        <input id="destacada" name="destacada" type="checkbox" value="1" checked={Boolean(guia?.destacada)} />
        <label for="destacada">Destacada en el catálogo</label>
      </div>
    </div>
  </section>

  <section class="admin-panel">
    <header class="admin-panel__header">
      <h2 class="admin-panel__titulo">Markdown</h2>
      <p class="admin-panel__nota">El HTML crudo está desactivado: la vista previa se genera en el servidor.</p>
    </header>
    <div class="admin-panel__body">
      <div class="admin-editor__area">
        <div class="admin-form__campo">
          <label for="cuerpoMd">Contenido</label>
          <textarea id="cuerpoMd" name="cuerpoMd" rows="22" required spellcheck="false">{cuerpoMd}</textarea>
        </div>
        <div class="admin-editor__preview">
          <p class="admin-editor__preview-titulo">Vista previa</p>
          <div class="admin-markdown" data-preview-zona set:html={htmlInicial} />
        </div>
      </div>
    </div>
  </section>

  {asistente && (
    <section class="admin-panel">
      <header class="admin-panel__header">
        <h2 class="admin-panel__titulo">Asistente IA</h2>
        <p class="admin-panel__nota">Envía el contexto de la guía y recibe una respuesta en Markdown para pegar en el editor.</p>
      </header>
      <div class="admin-panel__body admin-asistente">
        <div class="admin-form__campo">
          <label for="instruccion-ia">Instrucción</label>
          <textarea id="instruccion-ia" name="instruccion" rows="3" placeholder="Escribe una intro de 3 frases, sugiere un índice de pasos, corrige los comandos…"></textarea>
        </div>
        <div class="admin-filtros__acciones">
          <button type="button" class="admin-boton admin-boton--secondary" data-consultar-ia>Consultar</button>
          <button type="button" class="admin-boton admin-boton--plano" data-limpiar-ia>Limpiar</button>
        </div>
        <p class="admin-editor__estado admin-editor__estado--info" role="status" data-mensaje-ia hidden></p>
        <div class="admin-asistente__respuesta" data-respuesta-ia hidden>
          <div class="admin-markdown" data-markdown-ia />
          <button type="button" class="admin-boton admin-boton--secondary" data-insertar-ia>Insertar en el contenido</button>
        </div>
      </div>
    </section>
  )}

  <div class="admin-acciones">
    <button type="submit" class="admin-boton admin-boton--primary" data-guardar>Guardar guía</button>
    {tieneId && (
      <button type="button" class="admin-boton admin-boton--secondary" data-publicar={guia?.publicada ? 0 : 1}>
        {guia?.publicada ? 'Despublicar' : 'Publicar'}
      </button>
    )}
    {esAdmin && tieneId && (
      <button type="button" class="admin-boton admin-boton--danger" data-eliminar>Eliminar</button>
    )}
    <a class="admin-boton admin-boton--plano" href="/admin/guias/">Volver al listado</a>
  </div>
</form>