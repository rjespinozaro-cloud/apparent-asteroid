---
/**
 * Planeta de herramientas.
 *
 * El servidor dibuja la lista accesible completa (botones con nombre, progreso
 * nativo y porcentaje) y el script solo la mejora: añade el canvas, lee el
 * progreso local de las guías, conecta la selección y pinta la ficha. Sin
 * JavaScript se sigue pudiendo leer el catálogo de herramientas y sus equipos.
 *
 * El nivel es de solo lectura: no hay sliders ni autoevaluación.
 */
interface GuiaResumen {
  id: number;
  slug: string;
  titulo: string;
}

interface RutaResumen {
  slug: string;
  titulo: string;
}

interface Herramienta {
  slug: string;
  nombre: string;
  equipo: 'red' | 'blue' | 'purple' | null;
  guias: number;
  guiasLista: GuiaResumen[];
  rutas: RutaResumen[];
}

interface Props {
  herramientas: Herramienta[];
}

const { herramientas } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const GRUPOS = [
  { id: 'blue', titulo: 'Blue team · defensa' },
  { id: 'red', titulo: 'Red team · ataque' },
  { id: 'purple', titulo: 'Purple team · ambos' },
] as const;

const nombreEquipo = { red: 'Red team', blue: 'Blue team', purple: 'Purple team' } as const;

const grupos = GRUPOS.map((grupo) => ({
  ...grupo,
  herramientas: herramientas.filter((herramienta) => herramienta.equipo === grupo.id),
}));

const sinEquipo = herramientas.filter((herramienta) => herramienta.equipo === null);
const hayGuias = herramientas.some((herramienta) => herramienta.guias > 0);
const datos = herramientas.map(({ slug, nombre, equipo, guias, guiasLista, rutas }) => ({
  slug,
  nombre,
  equipo,
  guias,
  guiasLista,
  rutas,
}));
---

<section class="planeta contenedor" aria-labelledby="planeta-titulo" data-planeta data-herramientas={JSON.stringify(datos)}>
  {
    herramientas.length === 0 ? (
      <div class="planeta-vacio planeta-tarjeta">
        <h2 id="planeta-titulo">Todavía no hay herramientas publicadas</h2>
        <p>
          El planeta se llena con las herramientas del catálogo. Cuando haya guías publicadas, aparecerán aquí
          como cuerpos en órbita.
        </p>
        <a class="boton" href={`${base}guias/`}>
          Ver las guías
        </a>
      </div>
    ) : (
      <div class="perfil-layout">
        <div class="planeta-escena">
          <canvas
            class="planeta__canvas"
            data-planeta-canvas
            aria-hidden="true"
            width="720"
            height="540"
          />

          <p class="planeta-leyenda">
            <span class="eq-blue"><i aria-hidden="true"></i>Defensa</span>
            <span class="eq-red"><i aria-hidden="true"></i>Ataque</span>
            <span class="eq-purple"><i aria-hidden="true"></i>Ambos equipos</span>
          </p>

          <button type="button" class="planeta-descargar" data-planeta-png>
            Descargar PNG
          </button>

          {import.meta.env.DEV && Astro.url.searchParams.has('planeta-medir') && (
            <p class="planeta-hud" data-planeta-hud hidden aria-hidden="true"></p>
          )}
        </div>

        <div class="perfil-lateral">
          <section class="planeta-tarjeta" aria-labelledby="perfil-dominio-titulo">
            <div class="perfil-tarjeta__cab">
              <h2 id="perfil-dominio-titulo">Tu dominio</h2>
              <button
                type="button"
                class="boton boton--ghost perfil-ejemplo__boton"
                data-ejemplo
                aria-pressed="false"
              >
                Ver ejemplo
              </button>
            </div>
            <p class="planeta-tarjeta__cifra">
              <span data-planeta-general>0</span><small> % de media</small>
            </p>
            <div class="planeta-barras" data-planeta-barras>
              {GRUPOS.map((grupo) => (
                <div class="planeta-barra" data-equipo={grupo.id}>
                  <span>{nombreEquipo[grupo.id]}</span>
                  <span class="planeta-barra__pista">
                    <span class="planeta-barra__relleno" data-barra={grupo.id} data-equipo={grupo.id} />
                  </span>
                  <output data-barra-valor={grupo.id}>0 %</output>
                </div>
              ))}
            </div>
            <p class="perfil-aviso" data-ejemplo-aviso hidden role="status">
              <strong>Datos de ejemplo</strong> · No se guardan; tu progreso real sigue intacto.
            </p>
          </section>

          <section class="planeta-tarjeta perfil-ficha" aria-labelledby="perfil-ficha-titulo">
            <h2 id="perfil-ficha-titulo">Herramienta seleccionada</h2>
            <div data-planeta-detalle aria-live="polite">
              <p class="planeta-detalle__linea">
                Elige una herramienta de la lista o toca un cuerpo del planeta para ver su nivel y cómo subirlo.
              </p>
            </div>
            <p class="planeta-aviso" data-planeta-aviso hidden role="alert"></p>
          </section>
        </div>

        <section class="perfil-herramientas" aria-labelledby="planeta-titulo">
          <div class="perfil-herramientas__cab">
            <h2 id="planeta-titulo">Herramientas</h2>
            <a class="boton boton--ghost perfil-herramientas__enlace" href={`${base}guias/`}>Ver las guías</a>
          </div>
          <p class="perfil-herramientas__nota">
            {hayGuias
              ? 'El nivel se calcula con las guías que marques como completadas. Prácticas, examen y juegos llegarán más adelante.'
              : 'Todavía no hay guías publicadas de estas herramientas: el nivel empezará a calcularse cuando las haya.'}
          </p>

          <div class="perfil-equipos">
            {grupos.map((grupo) => (
              <section class="equipo" data-equipo={grupo.id} aria-labelledby={`equipo-${grupo.id}`}>
                <header class="equipo__cab">
                  <h3 class="equipo__titulo" id={`equipo-${grupo.id}`}>{grupo.titulo}</h3>
                  <span class="equipo__media">Media <span data-media={grupo.id}>0 %</span></span>
                </header>
                <ul class="equipo__lista" role="list">
                  {grupo.herramientas.map((herramienta) => (
                    <li>
                      <button
                        type="button"
                        class="herr"
                        data-elegir={herramienta.slug}
                        aria-pressed="false"
                      >
                        <span class="herr__nombre">{herramienta.nombre}</span>
                        <progress
                          data-progreso={herramienta.slug}
                          max="100"
                          value="0"
                          aria-label={`Nivel de ${herramienta.nombre}: 0 %`}
                        ></progress>
                        <span class="herr__pct" data-valor={herramienta.slug}>0 %</span>
                      </button>
                    </li>
                  ))}
                  {grupo.herramientas.length === 0 && (
                    <li class="equipo__vacio">Todavía no hay herramientas en este equipo.</li>
                  )}
                </ul>
              </section>
            ))}

            {sinEquipo.length > 0 && (
              <section class="equipo" data-equipo="neutral" aria-labelledby="equipo-neutral">
                <header class="equipo__cab">
                  <h3 class="equipo__titulo" id="equipo-neutral">Sin equipo</h3>
                  <span class="equipo__media">Media <span data-media="neutral">0 %</span></span>
                </header>
                <ul class="equipo__lista" role="list">
                  {sinEquipo.map((herramienta) => (
                    <li>
                      <button
                        type="button"
                        class="herr"
                        data-elegir={herramienta.slug}
                        aria-pressed="false"
                      >
                        <span class="herr__nombre">{herramienta.nombre}</span>
                        <progress
                          data-progreso={herramienta.slug}
                          max="100"
                          value="0"
                          aria-label={`Nivel de ${herramienta.nombre}: 0 %`}
                        ></progress>
                        <span class="herr__pct" data-valor={herramienta.slug}>0 %</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>

          <noscript>
            <p class="planeta-aviso">
              El planeta necesita JavaScript para dibujarse y leer tu progreso. La lista de herramientas, sus
              equipos y sus barras de nivel siguen estando disponibles arriba.
            </p>
          </noscript>
        </section>
      </div>
    )
  }
</section>
