---
interface Props {
  /** Ruta actual para marcar el enlace activo. */
  ruta?: string;
}

const { ruta = '/' } = Astro.props;

const enlaces = [
  { href: '/guias/', texto: 'Guías' },
  { href: '/herramientas/', texto: 'Herramientas' },
  { href: '/buscar/', texto: 'Buscar' },
  { href: '/aviso-legal/', texto: 'Aviso legal' },
];

/**
 * Un enlace está activo si la ruta coincide o si está dentro de su sección
 * (por ejemplo, /guias/red/nmap-basico/ mantiene activo "Guías").
 * @param {string} href
 */
function activo(href: string) {
  return href === '/' ? ruta === href : ruta === href || ruta.startsWith(href);
}
---

<nav class="menu" aria-label="Navegación principal">
  <ul class="menu__enlaces">
    {enlaces.map((enlace) => (
      <li>
        <a class="link--premium" href={enlace.href} aria-current={activo(enlace.href) ? 'page' : undefined}>{enlace.texto}</a>
      </li>
    ))}
    <li class="menu__buscar">
      <a href="/buscar/" class="menu__boton-buscar">
        <span aria-hidden="true">⌕</span>
        <span class="visualmente-oculto">Buscar guías</span>
      </a>
    </li>
    <li aria-hidden="true"><span class="menu__indicator"></span></li>
  </ul>
</nav>

<script>
  // Sliding menu indicator
  const menu = document.querySelector('.menu__enlaces');
  const indicator = menu?.querySelector('.menu__indicator');
  
  function positionIndicator() {
    if (!menu || !(indicator instanceof HTMLElement)) return;
    
    const activeLink = menu.querySelector('a[aria-current="page"]');
    if (!activeLink) {
      indicator.style.transform = 'translateX(0) scaleX(0)';
      return;
    }
    
    const rect = activeLink.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();
    const x = rect.left - menuRect.left;
    
    indicator.style.setProperty('--indicator-x', `${x}px`);
    indicator.style.setProperty('--indicator-scale', '1');
  }
  
  // Initial position
  positionIndicator();
  
  // Reposition on resize
  window.addEventListener('resize', positionIndicator);
  
  // Reposition on navigation (for SPA-like behavior)
  document.addEventListener('astro:page-load', positionIndicator);
</script>