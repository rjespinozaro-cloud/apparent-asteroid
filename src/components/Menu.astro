---
import { contarGuiasPublicadas, getDatabase } from '../lib/db.js';
import { env } from 'cloudflare:workers';

interface Props {
  /** Ruta actual para marcar el enlace activo. */
  ruta?: string;
}

const { ruta = '/' } = Astro.props;

// Prefijo de subpath (Pages: '/apparent-asteroid', Cloudflare: '/').
// En Cloudflare el resultado es idéntico a las rutas de antes.
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

/**
 * Insignia "Premium": solo aparece si hay guías de pago publicadas de verdad.
 * Sin guías de pago no se enlaza a un filtro vacío.
 */
const database = getDatabase(env);
const { total: guiasDePago } = await contarGuiasPublicadas(database, { acceso: 'pago' });
const hayPremium = guiasDePago > 0;

const enlaces = [
  { href: `${base}guias/`, texto: 'Guías' },
  { href: `${base}rutas/`, texto: 'Rutas' },
  { href: `${base}herramientas/`, texto: 'Herramientas' },
];

/** Contenido del desplegable "Más". Todos los destinos existen de verdad. */
const mas = [
  { href: `${base}nosotros/`, texto: 'Nosotros' },
  { href: `${base}etica/`, texto: 'Ética y uso responsable' },
  { href: `${base}aviso-legal/#contacto`, texto: 'Contacto' },
];

/**
 * Un enlace está activo si la ruta coincide o si está dentro de su sección
 * (por ejemplo, /guias/red/nmap-basico/ mantiene activo "Guías").
 * @param {string} href
 */
function activo(href: string) {
  return href === '/' ? ruta === href : ruta === href || ruta.startsWith(href);
}
---

<nav class="menu" aria-label="Navegación principal" data-menu>
  <button
    type="button"
    class="menu__alternar"
    aria-expanded="false"
    aria-controls="menu-lista"
    aria-label="Abrir menú"
    data-menu-alternar
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
  </button>
  <ul class="menu__enlaces" id="menu-lista">
    {enlaces.map((enlace) => (
      <li>
        <a href={enlace.href} aria-current={activo(enlace.href) ? 'page' : undefined}>{enlace.texto}</a>
      </li>
    ))}
    {hayPremium && (
      <li>
        <a class="menu__premium" href={`${base}guias/?acceso=pago`}>Premium</a>
      </li>
    )}
    <li class="menu__mas">
      <button
        type="button"
        class="menu__mas-boton"
        aria-expanded="false"
        aria-controls="menu-mas-lista"
        aria-label="Más secciones"
        data-menu-mas
      >
        Más
        <svg class="menu__mas-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>
      <ul class="menu__mas-lista" id="menu-mas-lista" data-menu-mas-lista hidden>
        {mas.map((entrada) => (
          <li>
            <a href={entrada.href} aria-current={activo(entrada.href) ? 'page' : undefined}>{entrada.texto}</a>
          </li>
        ))}
      </ul>
    </li>
    <li>
      <button
        type="button"
        class="menu__buscar"
        aria-label="Buscar guías (atajo Control+K)"
        data-menu-buscar
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
      </button>
    </li>
  </ul>
</nav>

<script>
  // Menú móvil: abrir/cerrar con foco y Escape.
  // Desplegable "Más": botón con aria-expanded (no role=menu) y Escape.
  // Atajo Ctrl/Cmd+K: abre el asistente si está en la página y, si no, va a /buscar/.
  const raiz = document.querySelector('[data-menu]');
  const alternar = raiz?.querySelector('[data-menu-alternar]');
  const lista = raiz?.querySelector('.menu__enlaces');
  const masBoton = raiz?.querySelector('[data-menu-mas]');
  const masLista = raiz?.querySelector('[data-menu-mas-lista]');
  const botonBuscar = raiz?.querySelector('[data-menu-buscar]');

  const baseSitio = (() => {
    const actual = window.location.pathname;
    return actual.startsWith('/apparent-asteroid') ? '/apparent-asteroid/' : '/';
  })();

  const abierto = () => raiz instanceof HTMLElement && raiz.classList.contains('menu--abierto');

  function fijarAbierto(valor: boolean) {
    if (!(raiz instanceof HTMLElement) || !(alternar instanceof HTMLButtonElement)) return;
    raiz.classList.toggle('menu--abierto', valor);
    alternar.setAttribute('aria-expanded', String(valor));
    alternar.setAttribute('aria-label', valor ? 'Cerrar menú' : 'Abrir menú');
    if (valor) {
      const primero = lista?.querySelector('a');
      if (primero instanceof HTMLAnchorElement) primero.focus();
    }
  }

  function masAbierto() {
    return masLista instanceof HTMLElement && !masLista.hidden;
  }

  function fijarMas(valor: boolean) {
    if (!(masLista instanceof HTMLElement) || !(masBoton instanceof HTMLButtonElement)) return;
    masLista.hidden = !valor;
    masBoton.setAttribute('aria-expanded', String(valor));
  }

  alternar?.addEventListener('click', () => fijarAbierto(!abierto()));

  masBoton?.addEventListener('click', () => {
    const siguiente = !masAbierto();
    fijarMas(siguiente);
    if (siguiente) {
      const primero = masLista?.querySelector('a');
      if (primero instanceof HTMLAnchorElement) primero.focus();
    }
  });

  // Clic fuera del desplegable lo cierra (mismo patrón en escritorio y móvil).
  document.addEventListener('click', (evento) => {
    if (!masAbierto()) return;
    const destino = evento.target;
    if (destino instanceof Node && masLista?.contains(destino)) return;
    if (destino instanceof Node && masBoton?.contains(destino)) return;
    fijarMas(false);
  });

  lista?.addEventListener('click', (evento) => {
    if (evento.target instanceof HTMLAnchorElement) {
      fijarAbierto(false);
      fijarMas(false);
    }
  });

  /** Atajo: abre el asistente si existe; si no, lleva a la página de búsqueda. */
  function abrirBusqueda() {
    const lanzador = document.querySelector('[data-ai-abrir]');
    // Ojo: el lanzador es `position: fixed`, así que `offsetParent` es siempre
    // null. Para saber si está disponible se comprueban los rectángulos.
    const disponible = lanzador instanceof HTMLButtonElement && lanzador.getClientRects().length > 0;
    if (disponible && lanzador instanceof HTMLButtonElement) {
      lanzador.click();
      const campo = document.querySelector('[data-ai-campo]');
      if (campo instanceof HTMLInputElement) {
        window.setTimeout(() => campo.focus({ preventScroll: true }), 60);
      }
      return;
    }
    window.location.href = `${baseSitio}buscar/`;
  }

  botonBuscar?.addEventListener('click', abrirBusqueda);

  document.addEventListener('keydown', (evento) => {
    const teclado = evento as KeyboardEvent;
    if ((teclado.ctrlKey || teclado.metaKey) && teclado.key.toLowerCase() === 'k') {
      teclado.preventDefault();
      abrirBusqueda();
      return;
    }
    if (teclado.key === 'Escape' && masAbierto()) {
      fijarMas(false);
      if (masBoton instanceof HTMLButtonElement) masBoton.focus();
      return;
    }
    if (teclado.key === 'Escape' && abierto()) {
      fijarAbierto(false);
      if (alternar instanceof HTMLButtonElement) alternar.focus();
    }
  });
</script>