---
import AssistantMascot from './AssistantMascot.astro';

/**
 * JOANIX AI flotante: launcher + invitación + diálogo.
 * Uso explícito por página (nunca en el portal): catálogo, guías,
 * herramientas y búsqueda. Una sola instancia por página.
 */
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---

<div class="ai" data-ai data-base={base}>
  <div class="ai-aviso" data-ai-aviso hidden>
    <p class="ai-aviso__texto">
      <strong>¿Necesitas ayuda?</strong><br />
      Te ayudo a encontrar una guía, herramienta o tema.
    </p>
    <div class="ai-aviso__acciones">
      <button type="button" class="boton--ghost" data-ai-aviso-abrir>Buscar una guía</button>
      <button type="button" class="boton--ghost" data-ai-aviso-sugerir>Sugerencia</button>
      <button type="button" class="ai-aviso__cerrar" aria-label="Descartar aviso" data-ai-aviso-cerrar>
        ×
      </button>
    </div>
  </div>

  <section
    id="ai-panel"
    class="ai-panel"
    role="dialog"
    aria-modal="false"
    aria-label="JOANIX AI: busca en el catálogo"
    data-ai-panel
    hidden
  >
    <div class="ai-panel__cabecera">
      <AssistantMascot estado="curious" clase="ai-panel__mascota" />
      <div class="ai-panel__titulo">
        <h2 id="ai-titulo">JOANIX AI</h2>
        <p role="status" data-ai-mensaje>Busca en el catálogo</p>
      </div>
      <button type="button" class="ai-cerrar" aria-label="Cerrar asistente" data-ai-cerrar>×</button>
    </div>

    <form class="ai-form" method="get" action={`${base}buscar/`} role="search" data-ai-form>
      <label class="visualmente-oculto" for="ai-q">Pregunta a JOANIX AI</label>
      <input
        id="ai-q"
        name="q"
        type="search"
        maxlength="80"
        autocomplete="off"
        enterkeyhint="search"
        placeholder="p. ej.: detectar escaneos nmap"
        data-ai-campo
      />
      <button class="boton--premium" type="submit" data-ai-boton>Preguntar</button>
    </form>

    <ul class="ai-acciones" aria-label="Acciones rápidas">
      <li><button type="button" class="chip" data-ai-accion="buscar">Buscar una guía</button></li>
      <li><button type="button" class="chip" data-ai-accion="sugerir">Dame una sugerencia</button></li>
      <li><button type="button" class="chip" data-ai-accion="duda">Tengo una duda</button></li>
    </ul>

    <div class="ai-resultados" aria-live="polite" data-ai-resultados hidden></div>
  </section>

  <button
    type="button"
    class="ai-launcher"
    aria-label="Abrir JOANIX AI"
    aria-expanded="false"
    aria-controls="ai-panel"
    data-ai-abrir
  >
    <AssistantMascot estado="assistant" decorativa eager />
    <span class="ai-launcher__etiqueta" aria-hidden="true">Pregúntale a JOANIX</span>
  </button>
</div>

<script type="module">
  /**
   * Arranque diferido del asistente: el módulo completo (`asistente.js`, con
   * su lógica de búsqueda) solo se descarga al primer contacto con el
   * lanzador. Este arranque mínimo oculta el asistente en /admin y /buscar y
   * gestiona el globo contextual (una vez por sesión tras 8 s de inactividad).
   */
  const raizAi = document.querySelector('[data-ai]');
  if (raizAi instanceof HTMLElement) {
    const rutaAi = window.location.pathname || '';
    if (/^\/(admin|buscar)(\/|$)/.test(rutaAi)) {
      raizAi.hidden = true;
    } else {
      const abrirAi = raizAi.querySelector('[data-ai-abrir]');
      const movimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let promesaAi = null;
      let listoAi = false;
      let abriendoAi = false;
      const importarAi = () => {
        if (!promesaAi) {
          promesaAi = import('../scripts/asistente.js')
            .then((modulo) => {
              listoAi = true;
              return modulo;
            })
            .catch(() => null);
        }
        return promesaAi;
      };
      abrirAi?.addEventListener('pointerenter', () => void importarAi());
      abrirAi?.addEventListener('focusin', () => void importarAi());
      abrirAi?.addEventListener('click', () => {
        if (listoAi || abriendoAi) return;
        abriendoAi = true;
        void importarAi().then((modulo) => {
          abriendoAi = false;
          if (modulo && abrirAi instanceof HTMLButtonElement) abrirAi.click();
        });
      });

      const CLAVE_GLOBO = 'joanix-ai-aviso';
      let globoVisto = false;
      try {
        globoVisto = sessionStorage.getItem(CLAVE_GLOBO) === '1';
      } catch {
        globoVisto = false;
      }
      let temporizadorAi = 0;
      const mostrarGlobo = () => {
        const panelAi = raizAi.querySelector('[data-ai-panel]');
        if (panelAi instanceof HTMLElement && !panelAi.hidden) {
          rearmarGlobo();
          return;
        }
        globoVisto = true;
        try {
          sessionStorage.setItem(CLAVE_GLOBO, '1');
        } catch {
          /* sin almacenamiento el globo puede repetirse */
        }
        void importarAi().then((modulo) => {
          if (modulo) raizAi.dispatchEvent(new CustomEvent('ai:mostrar-aviso'));
        });
      };
      const rearmarGlobo = () => {
        window.clearTimeout(temporizadorAi);
        if (globoVisto || movimiento) return;
        temporizadorAi = window.setTimeout(mostrarGlobo, 8000);
      };
      const rearmarPasivo = () => rearmarGlobo();
      window.addEventListener('pointermove', rearmarPasivo, { passive: true });
      window.addEventListener('pointerdown', rearmarPasivo, { passive: true });
      window.addEventListener('keydown', rearmarPasivo);
      window.addEventListener('scroll', rearmarPasivo, { passive: true });
      window.addEventListener('touchstart', rearmarPasivo, { passive: true });
      rearmarGlobo();
    }
  }
</script>
