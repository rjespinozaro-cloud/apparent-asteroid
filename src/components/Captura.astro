---
interface Props {
  src: string;
  alt: string;
  pie: string;
}

const { src, alt, pie } = Astro.props;
---

<figure class="captura">
  <button class="captura__boton" type="button" data-lightbox data-src={src} data-alt={alt} data-caption={pie}>
    <img src={src} alt={alt} loading="lazy" />
  </button>
  <figcaption>{pie}</figcaption>
</figure>
