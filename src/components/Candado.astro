---
interface Props {
  enlaceCompra: string;
}

const { enlaceCompra } = Astro.props;
---

<aside class="candado" aria-labelledby="candado-titulo">
  <p class="candado__estado">Contenido completo bloqueado</p>
  <h2 id="candado-titulo">Continúa con el PDF completo</h2>
  <p>Incluye todos los pasos de la guía, interpretación de resultados y comprobaciones defensivas para el laboratorio.</p>
  <a class="candado__enlace" href={enlaceCompra} rel="nofollow">Comprar PDF completo</a>
</aside>
