---
interface Props {
  /** URL externa de compra (normalmente una pasarela de pago). Puede ser null si no hay. */
  enlaceCompra?: string | null;
  /** Títulos reales de las secciones que continúan tras el corte. Nunca inventados. */
  incluye?: string[];
  /** Equipo de la guía, para el matiz del bloque. */
  equipo?: 'blue' | 'red';
}

const { enlaceCompra, incluye = [], equipo = 'blue' } = Astro.props;
---

<aside class:list={['candado', `candado--${equipo}`]} aria-labelledby="candado-titulo">
  <p class="candado__estado">Contenido premium</p>
  <h2 id="candado-titulo">La guía continúa en el PDF completo</h2>
  <p>
    Has leído el adelanto público: el laboratorio, el primer procedimiento y sus
    comprobaciones. El documento completo desarrolla el resto paso a paso, con
    interpretación de resultados y su correspondencia defensiva.
  </p>
  {incluye.length > 0 ? (
    <>
      <p class="candado__incluye-titulo">El PDF continúa con:</p>
      <ul class="candado__incluye">
        {incluye.map((seccion) => (
          <li>{seccion}</li>
        ))}
      </ul>
    </>
  ) : (
    <p>El PDF incluye el procedimiento completo, interpretación de resultados y comprobaciones defensivas.</p>
  )}
  {enlaceCompra ? (
    <a class="boton--premium" href={enlaceCompra} rel="nofollow noopener noreferrer" target="_blank">
      Obtener PDF
    </a>
  ) : (
    <p class="candado__aviso">Este PDF todavía no está disponible. Vuelve pronto.</p>
  )}
</aside>
