---
import AssistantMascot from './AssistantMascot.astro';
import { estadoCompra } from '../lib/pago.js';

interface Props {
  /** Slug de la guía: destino del resumen de compra. */
  slug: string;
  /** URL externa de compra (checkout alojado). Puede ser null si no hay. */
  enlaceCompra?: string | null;
  /** Títulos reales de las secciones que continúan tras el corte. Nunca inventados. */
  incluye?: string[];
  /** Equipo de la guía, para el matiz del bloque. */
  equipo?: 'blue' | 'red';
  /** Precio en céntimos; 0 o null = precio pendiente de configurar. */
  precioCentimos?: number | null;
  /** Código ISO 4217. */
  moneda?: string;
  /** Pasarela que gestiona el checkout alojado. */
  pasarela?: 'stripe' | 'lemonsqueezy' | 'polar' | 'manual' | null;
}

const {
  slug,
  enlaceCompra,
  incluye = [],
  equipo = 'blue',
  precioCentimos = null,
  moneda = 'EUR',
  pasarela = null,
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const compra = estadoCompra({
  slug,
  precioCentimos,
  moneda,
  pasarela,
  enlaceCompra,
}, base);
const { precio, proveedor, manual: esManual, disponible: puedeComprar, url: urlCompra } = compra;
---

<aside class:list={['candado', `candado--${equipo}`]} aria-labelledby="candado-titulo">
  <div class="candado__cabecera">
    <p class="candado__estado">Contenido premium</p>
    {precio && (
      <p class="candado__precio">
        {precio}
        <span>Pago único</span>
      </p>
    )}
  </div>

  <h2 id="candado-titulo">La guía continúa en el PDF completo</h2>
  <p>
    Has leído el adelanto público: el laboratorio, el primer procedimiento y sus
    comprobaciones. El documento completo desarrolla el resto paso a paso, con
    interpretación de resultados y su correspondencia defensiva.
  </p>

  {incluye.length > 0 ? (
    <>
      <div class="candado__recomienda">
        <AssistantMascot estado="suggestion" decorativa />
        <p class="candado__incluye-titulo">El PDF continúa con:</p>
      </div>
      <ul class="candado__incluye">
        {incluye.map((seccion) => (
          <li>{seccion}</li>
        ))}
      </ul>
    </>
  ) : (
    <p>El PDF incluye el procedimiento completo, interpretación de resultados y comprobaciones defensivas.</p>
  )}

  {puedeComprar ? (
    <div class="candado__compra">
      <a class="boton--premium candado__cta" href={urlCompra}>
        <span>Comprar PDF</span>
        <span class="candado__cta-flecha" aria-hidden="true">→</span>
      </a>

      <ul class="candado__sellos" aria-label="Condiciones de la compra">
        <li>Pago único</li>
        <li>PDF completo</li>
        <li>Entrega digital</li>
      </ul>

      <p class="candado__pago-nota">
        {esManual
          ? 'La compra se gestiona de forma manual. En el siguiente paso verás cómo completar el pago y recibir el PDF.'
          : `Revisarás el resumen y continuarás al checkout seguro de ${proveedor}. JOANIX no almacena los datos de tu tarjeta.`}
      </p>
      <p class="candado__pago-nota candado__pago-nota--suave">
        {precio ? `Precio final: ${precio}. ` : 'El precio final se confirma en la tienda. '}
        {esManual
          ? 'El pago y la entrega se coordinan de forma manual.'
          : 'La pasarela gestiona el cobro y la entrega del PDF.'}
      </p>
    </div>
  ) : (
    <p class="candado__aviso">La compra de este PDF aún no está habilitada. Vuelve pronto.</p>
  )}
</aside>
