---
import Base from '../layouts/Base.astro';
import AssistantMascot from '../components/AssistantMascot.astro';

export const prerender = false;

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title="Página no encontrada | JOANIX GUIDES"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <article class="pagina-error contenedor">
    <AssistantMascot estado="sad" tamano="lg" decorativa />
    <p class="eyebrow">Error 404</p>
    <h1>No hemos encontrado esa página</h1>
    <p>
      Puede que la dirección sea incorrecta o que la guía ya no esté publicada. Empieza por el catálogo o
      busca por texto.
    </p>
    <p class="pagina-error__acciones">
      <a class="boton" href={`${base}guias/`}>Ver todas las guías</a>
      <a class="boton boton--secundario" href={`${base}buscar/`}>Buscar por texto</a>
      <a class="boton boton--secundario" href={`${base}inicio/`}>Volver al inicio</a>
    </p>
  </article>
</Base>