---
import Base from '../layouts/Base.astro';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title="Página no encontrada | JOANIX - GUIDES"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <article class="error-pagina">
    <p class="admin-shell__eyebrow">Error 404</p>
    <h1>No hemos encontrado esa página</h1>
    <p>
      Puede que la dirección sea incorrecta o que la guía ya no esté publicada. Prueba desde el
      <a href="/guias/">listado de guías</a>.
    </p>
    <div class="admin-acciones">
      <a class="admin-boton admin-boton--secundario" href="/">Volver al inicio</a>
      <a class="admin-boton admin-boton--plano" href="/guias/">Ver todas las guías</a>
    </div>
  </article>
</Base>

<style>
  .error-pagina {
    background: var(--blanco);
    border: 1px solid var(--linea);
    border-left: 0.35rem solid var(--azul);
    margin: 0 auto;
    max-width: 44rem;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .error-pagina h1 {
    margin-bottom: var(--espacio-3);
  }

  .error-pagina p {
    color: var(--apagado);
    margin-bottom: var(--espacio-4);
  }
</style>