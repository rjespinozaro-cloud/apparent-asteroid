---
import Base from '../layouts/Base.astro';

export const prerender = false;

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title="Página no encontrada | JOANIX GUIDES"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <article class="pagina-error">
    <p class="eyebrow">Error 404</p>
    <h1>No hemos encontrado esa página</h1>
    <p>
      Puede que la dirección sea incorrecta o que la guía ya no esté publicada. Empieza por el catálogo o
      busca por texto.
    </p>
    <p class="pagina-error__acciones">
      <a class="boton" href="/guias/">Ver todas las guías</a>
      <a class="boton boton--secundario" href="/buscar/">Buscar por texto</a>
      <a class="boton boton--secundario" href="/inicio/">Volver al inicio</a>
    </p>
  </article>
</Base>