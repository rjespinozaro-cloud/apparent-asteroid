---
import Base from '../layouts/Base.astro';
import AssistantMascot from '../components/AssistantMascot.astro';

export const prerender = false;

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base
  title="Error del servidor | JOANIX GUIDES"
  description="Algo ha ido mal por nuestra parte. Inténtalo de nuevo en unos minutos."
  noindex
>
  <article class="pagina-error pagina-error--rojo contenedor">
    <AssistantMascot estado="sad" tamano="lg" decorativa />
    <p class="eyebrow">Error 500</p>
    <h1>Algo ha ido mal por nuestra parte</h1>
    <p>
      El fallo ya está registrado en el servidor. Vuelve a intentarlo en unos minutos; si persiste,
      escríbenos desde el <a href={`${base}aviso-legal/`}>aviso legal</a>.
    </p>
    <p class="pagina-error__acciones">
      <a class="boton" href={`${base}inicio/`}>Volver al inicio</a>
      <a class="boton boton--secundario" href={`${base}guias/`}>Ver todas las guías</a>
    </p>
  </article>
</Base>