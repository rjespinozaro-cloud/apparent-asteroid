---
import Base from '../../layouts/Base.astro';
import AsistenteFlotante from '../../components/AsistenteFlotante.astro';
import Migas from '../../components/Migas.astro';
import NodoCamino from '../../components/NodoCamino.astro';
import { getDatabase, listarGuiasCamino } from '../../lib/db.js';
import { construirCamino } from '../../data/camino.js';
import { tiendaActiva } from '../../lib/tienda.js';
import { EQUIPOS, nombreNivel } from '../../lib/vocabulario.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

const database = getDatabase(env);
const tienda = tiendaActiva(env);
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const guias = await listarGuiasCamino(database);
const { nodos } = construirCamino(guias, base);

const tronco = nodos.filter((nodo) => nodo.tramo === 'tronco');
const cierre = nodos.filter((nodo) => nodo.tramo === 'cierre');
const niveles = ['basico', 'intermedio', 'avanzado'].map((nivel) => ({
  nivel,
  red: nodos.filter((nodo) => nodo.tramo === 'red' && nodo.nivel === nivel),
  blue: nodos.filter((nodo) => nodo.tramo === 'blue' && nodo.nivel === nivel),
  purple: nodos.filter((nodo) => nodo.tramo === 'purple' && nodo.nivel === nivel),
}));

const disponibles = nodos.filter((n) => n.estado === 'disponible').length;
const proximamente = nodos.filter((n) => n.estado === 'proximamente').length;
const totalNiveles = niveles.length;
const totalNodos = nodos.length;

/* Datos reales por tramo para la barra de niveles: "X/Y disponibles". */
const nivelesNav = [
  { id: 'tronco', etiqueta: 'Fundamentos', nodos: tronco },
  ...niveles.map(({ nivel, red, blue, purple }) => ({
    id: nivel,
    etiqueta: nombreNivel(nivel),
    nodos: [...red, ...blue, ...purple],
  })),
  { id: 'cierre', etiqueta: 'Especialización', nodos: cierre },
].map(({ id, etiqueta, nodos: grupo }) => ({
  id,
  etiqueta,
  total: grupo.length,
  disponibles: grupo.filter((n) => n.estado === 'disponible').length,
}));

const rolRed = EQUIPOS.red.rol;
const rolBlue = EQUIPOS.blue.rol;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base
  title="El camino de leyendas | JOANIX"
  description="El viaje completo de JOANIX de un vistazo: Fundamentos, carriles RED y BLUE por niveles, nodos Purple donde se tocan y la especialización que está por venir."
  clase="catalogo-shell"
  claseBody="pagina-rutas"
>
  <section class="rutas-hero" aria-labelledby="rutas-titulo">
    <div class="rutas-hero__contenido contenedor">
      <Migas clase="rutas-migas__lista" items={[{ texto: 'Inicio', href: `${base}inicio/` }, { texto: 'Rutas' }]} />

      <h1 id="rutas-titulo" class="rutas-hero__titulo">
        El camino de <em>leyendas</em>
      </h1>

      <p class="rutas-lead">De los fundamentos a la especialización, paso a paso.</p>

      <details class="rutas-hero__info">
        <summary>¿Cómo se lee el mapa?</summary>
        <div class="rutas-hero__info-contenido">
          <p>
            El viaje completo, de un vistazo: un tronco común de Fundamentos que se
            bifurca en dos carriles —ofensiva RED y defensa BLUE—, se toca en los
            nodos Purple y cierra en la especialización que está por venir. Cada
            nodo está Disponible o Próximamente; nada más.
          </p>
        </div>
      </details>

      <div class="rutas-stats" aria-label="Estadísticas del camino">
        <span class="rutas-stat">
          <strong>{disponibles}</strong> disponibles
        </span>
        <span class="rutas-stat">
          <strong>{proximamente}</strong> próximamente
        </span>
        <span class="rutas-stat">
          <strong>{totalNiveles}</strong> niveles
        </span>
        <span class="rutas-stat">
          <strong>{totalNodos}</strong> nodos totales
        </span>
      </div>

      {/* Progreso local: oculto por defecto. El script solo lo muestra si
          hay datos en localStorage (nunca escribe nada en el servidor). */}
      <div id="progreso-recorrido" class="rutas-progreso" hidden>
        <progress class="rutas-progreso__barra" max={totalNodos} value="0"></progress>
        <span class="rutas-progreso__texto">0 de {totalNodos} completadas</span>
      </div>

      <div class="rutas-hero__acciones">
        <a class="boton--premium" href="#nivel-tronco">Empezar por Fundamentos</a>
      </div>
    </div>
  </section>

  <nav class="niveles contenedor" aria-label="Niveles del camino">
    <ul class="niveles__lista">
      {nivelesNav.map((nivel, i) => (
        <li>
          <a
            class="niveles__item"
            href={`#nivel-${nivel.id}`}
            data-nivel={nivel.id}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span class="niveles__nombre">{nivel.etiqueta}</span>
            <span class="niveles__datos">{nivel.disponibles}/{nivel.total}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="seccion camino contenedor" aria-labelledby="rutas-titulo">
    <ul class="leyenda" aria-label="Leyenda de estados">
      <li><span class="leyenda__icono leyenda__icono--disponible" aria-hidden="true"></span>Disponible</li>
      <li><span class="leyenda__icono leyenda__icono--proximamente" aria-hidden="true"></span>Próximamente</li>
      {tienda && <li><span class="leyenda__icono leyenda__icono--pago" aria-hidden="true"></span>Premium</li>}
    </ul>

    <div class="camino-tronco camino-anim" id="nivel-tronco">
      <h2 class="visualmente-oculto">Fundamentos</h2>
      <span class="camino-riel camino-riel--neutro" aria-hidden="true"></span>
      <ol aria-label="Fundamentos, tronco común">
        {tronco.map((nodo) => (
          <li>
            <NodoCamino nodo={nodo} base={base} />
          </li>
        ))}
      </ol>
    </div>

    {niveles.map(({ nivel, red, blue, purple }) => (
      <section class="camino-nivel" id={`nivel-${nivel}`} aria-labelledby={`titulo-${nivel}`}>
        <div class="camino-nivel__cabecera">
          <h2 class="camino-nivel__titulo" id={`titulo-${nivel}`}>Nivel {nombreNivel(nivel).toLowerCase()}</h2>
        </div>
        <div class="camino-carriles camino-carriles--nivel arbol">
          <div>
            <p class="camino-carril__etiqueta" aria-hidden="true">RED · {rolRed}</p>
            <ol class="camino-carril camino-carril--red camino-anim" aria-label={`Nivel ${nombreNivel(nivel).toLowerCase()} · RED`}>
              <span class="camino-riel camino-riel--rojo" aria-hidden="true"></span>
              {red.map((nodo) => (
                <li>
                  <NodoCamino nodo={nodo} base={base} />
                </li>
              ))}
            </ol>
          </div>
          <div>
            <p class="camino-carril__etiqueta" aria-hidden="true">BLUE · {rolBlue}</p>
            <ol class="camino-carril camino-carril--blue camino-anim" aria-label={`Nivel ${nombreNivel(nivel).toLowerCase()} · BLUE`}>
              <span class="camino-riel camino-riel--azul" aria-hidden="true"></span>
              {blue.map((nodo) => (
                <li>
                  <NodoCamino nodo={nodo} base={base} />
                </li>
              ))}
            </ol>
          </div>
        </div>
        {purple.length > 0 && (
          <div class="camino-puente camino-anim">
            <ol aria-label={`Nivel ${nombreNivel(nivel).toLowerCase()} · Purple`}>
              {purple.map((nodo) => (
                <li>
                  <NodoCamino nodo={nodo} base={base} />
                </li>
              ))}
            </ol>
          </div>
        )}
      </section>
    ))}

    <div class="camino-carriles arbol arbol--union" aria-hidden="true"></div>

    <div class="camino-cierre camino-anim" id="nivel-cierre">
      <h2 class="visualmente-oculto">Especialización</h2>
      <span class="camino-riel camino-riel--neutro" aria-hidden="true"></span>
      <ol aria-label="Especialización, tramo final">
        {cierre.map((nodo) => (
          <li>
            <NodoCamino nodo={nodo} base={base} />
          </li>
        ))}
      </ol>
    </div>

    <details id="lista-camino" class="camino-lista">
      <summary>Ver el camino como lista</summary>
      <ol>
        {nodos.map((nodo) => (
          <li>
            {nodo.href ? <a href={nodo.href}>{nodo.titulo}</a> : <span>{nodo.titulo}</span>}
            {' — '}
            {nodo.meta}
            {' · '}
            {nodo.estado === 'disponible' ? 'Disponible' : 'Próximamente'}
          </li>
        ))}
      </ol>
    </details>
  </section>

  <AsistenteFlotante />
</Base>

<script>
  import '../../scripts/camino.js';
  import '../../scripts/rutas-hero.js';
</script>