---
import Base from '../../layouts/Base.astro';
import AsistenteFlotante from '../../components/AsistenteFlotante.astro';
import Migas from '../../components/Migas.astro';
import TarjetaRuta from '../../components/TarjetaRuta.astro';
import { getDatabase, listarRutasConTipologia } from '../../lib/db.js';
import { plural } from '../../lib/utils/texto.js';
import { opcion } from '../../lib/validar.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

const database = getDatabase(env);
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const tipo = opcion(Astro.url.searchParams.get('tipo'), ['red', 'blue', 'purple']);
const fichas = await listarRutasConTipologia(database);
const rutas = tipo ? fichas.filter((ficha) => ficha.tipologia.tipo === tipo) : fichas;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base
  title="Rutas de aprendizaje | JOANIX GUIDES"
  description="Rutas de aprendizaje de ciberseguridad en JOANIX GUIDES: secuencias ordenadas de guías RED y BLUE, del laboratorio a la defensa."
>
  <Migas items={[{ texto: 'Inicio', href: `${base}inicio/` }, { texto: 'Rutas' }]} />

  <section class="seccion seccion--rutas" aria-labelledby="rutas-titulo">
    <div>
      <p class="eyebrow">Rutas de aprendizaje</p>
      <h1 id="rutas-titulo">Aprende en orden</h1>
      <p class="entradilla">
        Secuencias ordenadas de guías: cada paso enlaza una guía real; si aún no está publicada, se marca como Próximamente.
      </p>
      <p class="guia__meta-catalogo">
        {plural(rutas.length, 'ruta publicada', 'rutas publicadas')}
      </p>
    </div>

    <ul class="chips-rapidos" aria-label="Filtrar por tipo">
      <li><a class="chip-filtro" href={`${base}rutas/`} aria-current={!tipo ? 'true' : undefined}>Todas</a></li>
      <li><a class="chip-filtro" href={`${base}rutas/?tipo=red`} aria-current={tipo === 'red' ? 'true' : undefined}>RED</a></li>
      <li><a class="chip-filtro" href={`${base}rutas/?tipo=blue`} aria-current={tipo === 'blue' ? 'true' : undefined}>BLUE</a></li>
      <li><a class="chip-filtro" href={`${base}rutas/?tipo=purple`} aria-current={tipo === 'purple' ? 'true' : undefined}>Purple</a></li>
    </ul>

    {rutas.length > 0 ? (
      <div class:list={['rutas-conjunto', rutas.length === 1 && 'rutas-conjunto--una']}>
        <ul class="rejilla-tarjetas">
          {rutas.map(({ ruta, tipologia }) => (
            <li>
              <TarjetaRuta ruta={ruta} tipologia={tipologia} primerPaso={tipologia.primer_paso} />
            </li>
          ))}
        </ul>
        {rutas.length === 1 && (
          <aside class="rutas-ayuda" aria-label="Cómo funcionan las rutas">
            <h2>Cómo funcionan las rutas</h2>
            <p>
              Las rutas ordenan guías publicadas en pasos numerados. Cada paso
              enlaza una guía real; si aún no está publicada verás
              «Próximamente». Avanza en orden: del laboratorio a la defensa.
            </p>
          </aside>
        )}
      </div>
    ) : (
      <div class="vacio">
        <p>No hay rutas de este tipo todavía.</p>
        <p><a class="boton" href={`${base}rutas/`}>Ver todas las rutas</a></p>
      </div>
    )}
  </section>

  <AsistenteFlotante />
</Base>

<script>
  import '../../scripts/ruta-anim.js';
</script>
