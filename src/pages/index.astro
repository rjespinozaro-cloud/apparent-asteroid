      <i class="bars bars--b" aria-hidden="true"></i>

      <div class="cover__sparks" aria-hidden="true">
        <i class="spark spark--r"></i><i class="spark spark--r"></i><i class="spark spark--r"></i><i class="spark spark--r"></i><i class="spark spark--b"></i><i class="spark spark--b"></i><i class="spark spark--b"></i><i class="spark spark--b"></i>
      </div>

      <canvas class="cover__bolt" id="bolt" aria-hidden="true"></canvas>
      <div class="cover__flash" id="flash" aria-hidden="true"></div>

      <i class="hud hud--tl" aria-hidden="true"></i>
      <i class="hud hud--tr" aria-hidden="true"></i>
      <i class="hud hud--bl" aria-hidden="true"></i>
      <i class="hud hud--br" aria-hidden="true"></i>

      <header class="cover__top">
        <h1 class="cover__brand">JOANIX<span>GUIDES</span></h1>
        <p class="cover__tag">Cybersecurity Knowledge Lab</p>
      </header>

      <div class="logo" id="logo">
        <i class="logo__ring logo__ring--a" aria-hidden="true"></i>
        <i class="logo__ring logo__ring--b" aria-hidden="true"></i>
