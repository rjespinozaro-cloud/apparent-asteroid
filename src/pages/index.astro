---
/**
 * MEGAPORTADA JOANIX GUIDES — RED vs BLUE, el choque emerge PURPLE TEAM.
 *
 * Narrativa: mitad atacante (rojo) y mitad defensa (azul) convergen al centro,
 * cae un rayo procedural (canvas, único por carga) y el logo se enciende en
 * violeta con el texto PURPLE TEAM. Una sola pantalla, sin scroll.
 *
 * Color: fondo #05060C; rojo #ff2e4d, azul #2e8bff, violeta de unión #a855f7
 * (--purple en tokens). Tipografía de sistema a propósito (cero fuentes
 * bloqueantes en el LCP). Logo public/logo.png intrínseco 640x320 (2:1).
 * Fotos: public/hero/hero-wide (1024x572) y hero-tall (572x1024).
 */

export const prerender = true;

const baseBruto = import.meta.env.BASE_URL;
// BASE_URL puede venir sin barra final ('/apparent-asteroid'): se normaliza
// una vez para que `${base}ruta` siempre genere '/base/ruta' (o '/ruta').
const base = `${baseBruto.replace(/\/+$/, '')}/`;
const title = 'JOANIX GUIDES | Cybersecurity Knowledge Lab';
const description =
  'JOANIX GUIDES — laboratorio de conocimiento en ciberseguridad: guías prácticas de hacking ético para equipos RED y BLUE. Del choque nace el PURPLE TEAM.';
const origen = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origen).href;
const imagenOg = new URL(`${base}og-image.png`, origen).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05060C" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" as="image" href={`${base}hero/hero-tall.avif`} fetchpriority="high" media="(max-aspect-ratio: 1/1)" />
    <link rel="preload" as="image" href={`${base}hero/hero-wide.avif`} fetchpriority="high" media="(min-aspect-ratio: 1/1)" />
    <link rel="prefetch" href={`${base}inicio/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JOANIX GUIDES" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JOANIX GUIDES, guías de ciberseguridad RED y BLUE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />
    <title>{title}</title>
    <style>
      /* LÉXICO DE MOVIMIENTO (vocabulario preciso):
         foto      = Fade in + Scale 1.04→1.10 (push-in cinematográfico, 3.2s, una vez)
         mitades   = Slide in hacia el centro ±2.5% (ease-out fuerte, una vez)
         seam      = Charge en la grieta (scaleY + Fade, sincronizada a --t-hit)
         bars      = Apertura letterbox (height 11dvh→0, una vez al cargar)
         chispas   = Float hacia el centro + Pulse (opacity/translate, loops lentos)
         rayo      = Bolt procedural en canvas (flicker 2-3 veces, único por carga)
         flash     = Fade out blanco (opacity, 120ms)
         shake     = Translate amortiguado ±5px sobre foto+rayo (una vez, 500ms)
         ignición  = State indication (drop-shadow violeta) + anillos Burst (Scale+Fade, una vez)
         equipo    = Tracking settle + Fade in + Glitch RGB por data-text (state indication)
         botón     = Glass + Press feedback + glow radial que sigue al puntero (--px/--py)
         reposo    = Pulse de glow + mini-arcos cada 8-12s (ráfagas cortas, sin loop 60fps)
         salida    = Scale + Fade out + flash violeta (500ms, una vez por visita) */

      @property --angle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
      }

      :root {
        --bg: #05060c;
        --ink: #e8eaf6;
        --ink-dim: #8a90b2;
        --ink-hint: #b9c1d6;
        --red: #ff2e4d;
        --red-deep: #5e1226;
        --blue: #2e8bff;
        --blue-deep: #16295e;
        --purple: #a855f7;
        --purple-hot: #d8b4fe;
        --logo-size: clamp(180px, 38vmin, 460px);
        --pad: clamp(16px, 3.2vmin, 40px);
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --t-hit: 1.35s;
        --mx: 0;
        --my: 0;
        color-scheme: dark;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        overscroll-behavior: none;
        background: var(--bg);
        -webkit-text-size-adjust: 100%;
      }

      ::selection {
        background: var(--purple);
        color: #fff;
      }

      body {
        position: fixed;
        inset: 0;
        width: 100%;
        color: var(--ink);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        -webkit-tap-highlight-color: transparent;
      }

      .cover {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
        isolation: isolate;
        padding:
          max(var(--pad), env(safe-area-inset-top))
          max(var(--pad), env(safe-area-inset-right))
          max(var(--pad), env(safe-area-inset-bottom))
          max(var(--pad), env(safe-area-inset-left));
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        transition: opacity 0.55s var(--ease), filter 0.55s var(--ease);
      }

      /* ---------- FONDO DE RESPALDO (si la foto falla) ---------- */
      .cover__bg,
      .cover__bg > i {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .cover__bg {
        z-index: 0;
      }

      .aurora {
        width: 70vmax;
        height: 70vmax;
        inset: auto;
        top: 50%;
        border-radius: 50%;
        filter: blur(clamp(60px, 10vmax, 140px));
        opacity: 0.55;
        mix-blend-mode: screen;
        will-change: transform, opacity;
      }
      .aurora--red {
        left: 0;
        background: radial-gradient(circle at 40% 50%, var(--red) 0%, var(--red-deep) 38%, transparent 70%);
        transform: translate(-62%, -50%);
        animation: breatheRed 9s ease-in-out infinite;
      }
      .aurora--blue {
        right: 0;
        background: radial-gradient(circle at 60% 50%, var(--blue) 0%, var(--blue-deep) 38%, transparent 70%);
        transform: translate(62%, -50%);
        animation: breatheBlue 9s ease-in-out infinite;
      }
      @keyframes breatheRed {
        0%,
        100% {
          transform: translate(-62%, -50%) scale(1);
          opacity: 0.45;
        }
        50% {
          transform: translate(-54%, -52%) scale(1.12);
          opacity: 0.7;
        }
      }
      @keyframes breatheBlue {
        0%,
        100% {
          transform: translate(62%, -50%) scale(1.12);
          opacity: 0.7;
        }
        50% {
          transform: translate(54%, -48%) scale(1);
          opacity: 0.45;
        }
      }

      .grid {
        background-image:
          linear-gradient(rgba(150, 180, 255, 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(150, 180, 255, 0.07) 1px, transparent 1px);
        background-size: clamp(32px, 6vmin, 64px) clamp(32px, 6vmin, 64px);
        -webkit-mask-image: radial-gradient(ellipse at center, #000 0%, transparent 72%);
        mask-image: radial-gradient(ellipse at center, #000 0%, transparent 72%);
        animation: gridDrift 40s linear infinite;
      }
      @keyframes gridDrift {
        to {
          background-position: 64px 64px, 64px 64px;
        }
      }

      .noise {
        inset: -10%;
        opacity: 0.08;
        mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        animation: grain 1s steps(5) infinite;
      }
      @keyframes grain {
        0% { transform: translate(0, 0); }
        25% { transform: translate(-3%, 2%); }
        50% { transform: translate(2%, -3%); }
        75% { transform: translate(-2%, -2%); }
        100% { transform: translate(3%, 3%); }
      }

      .scan {
        opacity: 0.35;
        background: repeating-linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 0,
          rgba(0, 0, 0, 0) 2px,
          rgba(0, 0, 0, 0.28) 3px
        );
      }

      .vignette {
        background: radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, 0.75) 100%);
      }

      /* Barras letterbox: abren la escena al cargar y se retraen. */
      .bars {
        position: absolute;
        left: 0;
        right: 0;
        z-index: 7;
        height: 0;
        background: #000;
        pointer-events: none;
      }
      .bars--t {
        top: 0;
      }
      .bars--b {
        bottom: 0;
      }
      /* Apertura cinematográfica: las barras se retraen solas al cargar
         (scaleY con origen en el borde: GPU, sin layout). */
      .bars {
        height: 11dvh;
        animation: barsOpen 1.4s var(--ease) both;
      }
      .bars--t {
        transform-origin: top;
      }
      .bars--b {
        transform-origin: bottom;
      }
      @keyframes barsOpen {
        from {
          transform: scaleY(1);
        }
        to {
          transform: scaleY(0);
        }
      }
      @keyframes bars {
        from {
          height: 11dvh;
        }
        to {
          height: 0;
        }
      }

      /* Costura de luz en la grieta del choque. */
      .seam {
        position: absolute;
        z-index: 2;
        left: 50%;
        top: -10%;
        bottom: -10%;
        width: 3px;
        translate: -50% 0;
        opacity: 0.3;
        background: linear-gradient(to bottom, transparent, var(--purple-hot) 22%, #fff 50%, var(--purple-hot) 78%, transparent);
        box-shadow: 0 0 22px 5px rgba(168, 85, 247, 0.65);
        pointer-events: none;
      }
      .seam {
        animation: seamCharge 2.6s var(--t-hit) var(--ease) both;
      }
      @keyframes seamCharge {
        0% {
          opacity: 0;
          transform: scaleY(0.2);
        }
        25% {
          opacity: 1;
          transform: scaleY(1);
        }
        100% {
          opacity: 0.3;
          transform: scaleY(1);
        }
      }

      /* ---------- FOTO NARRATIVA (RED vs BLUE) ---------- */
      .cover__photo {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        animation: photoIn 3.2s var(--ease) both;
      }
      .cover__photo.is-missing {
        display: none;
      }
      @keyframes photoIn {
        from {
          opacity: 0;
          transform: scale(1.04);
        }
        to {
          opacity: 1;
          transform: scale(1.1);
        }
      }

      .cover__half {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
      .cover__half picture,
      .cover__half img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
      /* Escritorio: atacante izquierda / defensa derecha, convergen al centro. */
      .cover__half--red {
        clip-path: inset(0 50% 0 0);
        animation: clashLeft 1.4s var(--ease) 0.3s both;
      }
      .cover__half--blue {
        clip-path: inset(0 0 0 50%);
        animation: clashRight 1.4s var(--ease) 0.3s both;
      }
      .cover__half--red::after,
      .cover__half--blue::after {
        content: '';
        position: absolute;
        inset: 0;
      }
      .cover__half--red::after {
        background: linear-gradient(90deg, rgba(255, 46, 77, 0.28), transparent 70%);
      }
      .cover__half--blue::after {
        background: linear-gradient(270deg, rgba(46, 139, 255, 0.28), transparent 70%);
      }
      @keyframes clashLeft {
        from {
          transform: translateX(-2.5%);
        }
        to {
          transform: translateX(0);
        }
      }
      @keyframes clashRight {
        from {
          transform: translateX(2.5%);
        }
        to {
          transform: translateX(0);
        }
      }

      /* ---------- SCRIMS (contraste AA + viñeta lateral móvil) ---------- */
      .cover__scrim {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
      }
      .cover__scrim--top {
        background: linear-gradient(to bottom, rgba(5, 6, 12, 0.72), transparent 32%);
      }
      .cover__scrim--bottom {
        background: linear-gradient(to top, rgba(5, 6, 12, 0.92), transparent 50%);
      }
      .cover__scrim--spot {
        background: radial-gradient(ellipse at center, rgba(5, 6, 12, 0.55), transparent 62%);
      }

      /* ---------- CHISPAS ---------- */
      .cover__sparks {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
      }
      .spark {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        opacity: 0;
        animation: sparkFloat 5s ease-in-out infinite;
      }
      .spark--r {
        background: var(--red);
        box-shadow: 0 0 8px 2px rgba(255, 46, 77, 0.8);
      }
      .spark--b {
        background: var(--blue);
        box-shadow: 0 0 8px 2px rgba(46, 139, 255, 0.8);
      }
      .spark:nth-child(1) { left: 12%; top: 46%; --dx: 9vw; --dy: -3vh; animation-delay: 0.4s; }
      .spark:nth-child(2) { left: 20%; top: 58%; --dx: 7vw; --dy: 3vh; animation-delay: 1.6s; animation-duration: 6s; }
      .spark:nth-child(3) { left: 8%; top: 36%; --dx: 11vw; --dy: 1vh; animation-delay: 2.4s; animation-duration: 4.2s; }
      .spark:nth-child(4) { left: 26%; top: 50%; --dx: 5vw; --dy: -4vh; animation-delay: 3s; animation-duration: 5.4s; }
      .spark:nth-child(5) { left: 88%; top: 44%; --dx: -9vw; --dy: 3vh; animation-delay: 0.9s; }
      .spark:nth-child(6) { left: 80%; top: 60%; --dx: -7vw; --dy: -3vh; animation-delay: 2s; animation-duration: 6.2s; }
      .spark:nth-child(7) { left: 92%; top: 54%; --dx: -11vw; --dy: -1vh; animation-delay: 2.8s; animation-duration: 4.6s; }
      .spark:nth-child(8) { left: 74%; top: 40%; --dx: -5vw; --dy: 4vh; animation-delay: 3.4s; animation-duration: 5.8s; }
      @keyframes sparkFloat {
        0% {
          transform: translate(0, 0);
          opacity: 0;
        }
        25% {
          opacity: 0.9;
        }
        100% {
          transform: translate(var(--dx), var(--dy));
          opacity: 0;
        }
      }

      /* ---------- RAYO (canvas) + FLASH + SHAKE ---------- */
      .cover__bolt {
        position: absolute;
        inset: 0;
        z-index: 4;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }
      .cover__flash {
        position: absolute;
        inset: 0;
        z-index: 6;
        background: radial-gradient(ellipse at center, #fff, transparent 70%);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.12s ease-out;
      }
      .cover__flash.is-on {
        opacity: 0.55;
      }
      .cover.is-leaving .cover__flash {
        background: radial-gradient(ellipse at center, var(--purple), transparent 70%);
        opacity: 0.8;
        transition: opacity 0.5s var(--ease);
      }
      /* El shake mueve la escena visible (foto + rayo), no un div vacío. */
      .cover.is-shake .cover__photo,
      .cover.is-shake .cover__bolt {
        animation: shakeX 0.5s var(--ease);
      }
      @keyframes shakeX {
        0%, 100% { transform: translate(0, 0); }
        20% { transform: translate(5px, -3px); }
        40% { transform: translate(-4px, 2px); }
        60% { transform: translate(3px, -1px); }
        80% { transform: translate(-1px, 1px); }
      }

      /* ---------- HUD ESQUINAS ---------- */
      .hud {
        position: absolute;
        z-index: 7;
        width: clamp(22px, 5vmin, 54px);
        height: clamp(22px, 5vmin, 54px);
        border: 0 solid rgba(200, 215, 255, 0.35);
        pointer-events: none;
        opacity: 0.9;
        animation: hudIn 1.1s var(--ease) both;
      }
      .hud--tl {
        top: max(var(--pad), env(safe-area-inset-top));
        left: max(var(--pad), env(safe-area-inset-left));
        border-top-width: 2px;
        border-left-width: 2px;
        border-top-left-radius: 6px;
      }
      .hud--tr {
        top: max(var(--pad), env(safe-area-inset-top));
        right: max(var(--pad), env(safe-area-inset-right));
        border-top-width: 2px;
        border-right-width: 2px;
        border-top-right-radius: 6px;
      }
      .hud--bl {
        bottom: max(var(--pad), env(safe-area-inset-bottom));
        left: max(var(--pad), env(safe-area-inset-left));
        border-bottom-width: 2px;
        border-left-width: 2px;
        border-bottom-left-radius: 6px;
      }
      .hud--br {
        bottom: max(var(--pad), env(safe-area-inset-bottom));
        right: max(var(--pad), env(safe-area-inset-right));
        border-bottom-width: 2px;
        border-right-width: 2px;
        border-bottom-right-radius: 6px;
      }
      .hud--tl,
      .hud--bl {
        border-image: linear-gradient(135deg, var(--red), transparent 70%) 1;
      }
      .hud--tr,
      .hud--br {
        border-image: linear-gradient(225deg, var(--blue), transparent 70%) 1;
      }
      @keyframes hudIn {
        from {
          opacity: 0;
          transform: scale(1.4);
        }
        to {
          opacity: 0.9;
          transform: scale(1);
        }
      }

      /* ---------- WORDMARK (ARRIBA, ABSOLUTE) ---------- */
      .cover__top {
        position: absolute;
        z-index: 8;
        top: max(calc(var(--pad) * 1.8), env(safe-area-inset-top));
        left: 0;
        right: 0;
        text-align: center;
        animation: riseIn 1s 0.15s var(--ease) both;
      }
      .cover__brand {
        margin: 0;
        font-size: clamp(1.1rem, 3.2vmin, 2rem);
        font-weight: 800;
        letter-spacing: 0.38em;
        text-indent: 0.38em;
        text-transform: uppercase;
        background: linear-gradient(90deg, var(--red), #fff 48%, var(--blue));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 24px rgba(0, 0, 0, 0.6);
      }
      .cover__brand span {
        font-weight: 300;
        margin-left: 0.5em;
      }
      .cover__tag {
        margin: 0.6em 0 0;
        font-size: clamp(0.68rem, 1.6vmin, 0.9rem);
        letter-spacing: 0.5em;
        text-indent: 0.5em;
        text-transform: uppercase;
        color: var(--ink-dim);
      }

      /* ---------- LOGO CENTRAL (CENTRO GEOMÉTRICO EXACTO) ---------- */
      .logo {
        position: relative;
        z-index: 5;
        display: grid;
        place-items: center;
        width: var(--logo-size);
        height: var(--logo-size);
        transform: translate3d(calc(var(--mx) * 10px), calc(var(--my) * 10px), 0);
        transition: transform 0.25s ease-out;
        animation: logoIn 1.3s var(--ease) backwards;
      }
      .logo__img {
        position: relative;
        z-index: 2;
        width: 100%;
        height: auto;
        aspect-ratio: 2 / 1;
        object-fit: contain;
        /* El asset trae la X casi pegada al borde derecho: aire para el
           glifo. Fondo transparente limpio, sin halo en reposo: el violeta
           solo aparece en la ignición del impacto. */
        padding: 1% 4% 2% 0;
        user-select: none;
        -webkit-user-drag: none;
        animation: float 6s ease-in-out infinite;
        transition: filter 0.6s var(--ease);
      }
      .logo.is-lit .logo__img {
        filter:
          drop-shadow(0 0 18px rgba(168, 85, 247, 0.9))
          drop-shadow(0 0 46px rgba(168, 85, 247, 0.55));
      }
      .logo__glow {
        position: absolute;
        inset: -22%;
        z-index: 1;
        border-radius: 50%;
        background: conic-gradient(from 0deg, var(--red), transparent 30%, var(--blue) 55%, transparent 80%, var(--red));
        filter: blur(clamp(30px, 6vmin, 70px));
        opacity: 0.26;
        animation: spin 14s linear infinite, pulse 4s ease-in-out infinite;
      }
      .logo__glow--violet {
        background: conic-gradient(from 90deg, var(--purple), transparent 35%, var(--purple) 60%, transparent 85%, var(--purple));
        opacity: 0;
        transition: opacity 0.8s var(--ease);
        animation: spin 18s linear infinite reverse;
      }
      .logo.is-lit .logo__glow--violet {
        opacity: 0.55;
      }
      .logo__ring {
        position: absolute;
        z-index: 1;
        border-radius: 50%;
        border: 1px solid rgba(190, 210, 255, 0.22);
      }
      .logo__ring--a {
        inset: -12%;
        border-style: dashed;
        border-color: rgba(255, 77, 109, 0.4);
        animation: spin 40s linear infinite;
      }
      .logo__ring--b {
        inset: -26%;
        border-color: rgba(77, 124, 255, 0.3);
        border-top-color: transparent;
        border-bottom-color: transparent;
        animation: spin 26s linear infinite reverse;
      }
      .logo__ring--burst {
        inset: -6%;
        border: 2px solid var(--purple);
        opacity: 0;
      }
      .cover.is-impact .logo__ring--burst {
        animation: burst 1.2s var(--ease) both;
      }
      .cover.is-impact .logo__ring--burst.logo__ring--c {
        animation-delay: 0.15s;
      }
      @keyframes burst {
        from {
          transform: scale(0.8);
          opacity: 0.9;
        }
        to {
          transform: scale(1.7);
          opacity: 0;
        }
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 0.25;
        }
        50% {
          opacity: 0.5;
        }
      }
      @keyframes float {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-1.2%);
        }
      }
      @keyframes logoIn {
        from {
          opacity: 0;
          transform: scale(0.9);
          filter: blur(12px);
        }
        to {
          opacity: 1;
          transform: scale(1);
          filter: blur(0);
        }
      }

      /* ---------- PURPLE TEAM (HTML real, bajo el logo) ---------- */
      .cover__team {
        position: absolute;
        z-index: 8;
        top: calc(50% + clamp(70px, 11vmin, 130px));
        left: 0;
        right: 0;
        margin: 0;
        padding-inline: 8px;
        text-align: center;
        font-size: clamp(1.15rem, 4.4vmin, 2.4rem);
        font-weight: 800;
        letter-spacing: 0.55em;
        text-indent: 0.55em;
        text-transform: uppercase;
        white-space: nowrap;
        background: linear-gradient(90deg, var(--red) 0%, #ff8fd1 22%, #fff 50%, #9fc8ff 78%, var(--blue) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 14px rgba(168, 85, 247, 0.55));
        opacity: 0;
      }
      .cover.is-impact .cover__team {
        opacity: 1;
        letter-spacing: 0.42em;
        text-indent: 0.42em;
        transition: opacity 0.9s var(--ease), letter-spacing 1s var(--ease), text-indent 1s var(--ease);
      }
      /* Glitch RGB del texto por data-text (una vez al impacto + eco ocasional). */
      .cover__team::before,
      .cover__team::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        opacity: 0;
        mix-blend-mode: screen;
        background: none;
        -webkit-text-fill-color: currentColor;
        pointer-events: none;
      }
      .cover__team::before {
        color: var(--red);
      }
      .cover__team::after {
        color: var(--blue);
      }
      .cover.is-impact .cover__team::before {
        animation: glitchHit 0.5s steps(1) forwards, glitchIdle 9s 4s infinite steps(1);
      }
      .cover.is-impact .cover__team::after {
        animation: glitchHit 0.5s 0.04s steps(1) forwards, glitchIdle 9s 4.06s infinite steps(1);
      }
      @keyframes glitchHit {
        0% { opacity: 1; clip-path: inset(10% 0 70% 0); transform: translate(-6px, 0); }
        20% { clip-path: inset(60% 0 10% 0); transform: translate(5px, 0); }
        40% { clip-path: inset(30% 0 40% 0); transform: translate(-3px, 0); }
        60% { clip-path: inset(75% 0 5% 0); transform: translate(4px, 0); }
        80% { clip-path: inset(5% 0 80% 0); transform: translate(-2px, 0); }
        100% { opacity: 0; clip-path: inset(0); transform: none; }
      }
      @keyframes glitchIdle {
        0%, 94%, 100% { opacity: 0; }
        95% { opacity: 1; clip-path: inset(20% 0 55% 0); transform: translate(-4px, 0); }
        97% { opacity: 1; clip-path: inset(60% 0 15% 0); transform: translate(3px, 0); }
      }

      /* ---------- CTA (ABAJO, ABSOLUTE) ---------- */
      .cover__bottom {
        position: absolute;
        z-index: 8;
        bottom: max(calc(var(--pad) * 1.8), env(safe-area-inset-bottom));
        left: 0;
        right: 0;
        display: grid;
        justify-items: center;
        gap: 1.2em;
        animation: riseIn 1s 0.35s var(--ease) both;
      }
      .cta {
        --angle: 0deg;
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.8em;
        padding: 0.95em 2.4em;
        min-height: 48px;
        border-radius: 999px;
        color: var(--ink);
        font-size: clamp(0.85rem, 2vmin, 1.05rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.28em;
        text-indent: 0.28em;
        text-transform: uppercase;
        text-decoration: none;
        isolation: isolate;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0)), rgba(12, 9, 24, 0.55);
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        backdrop-filter: blur(14px) saturate(1.4);
        transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 8px 30px -10px rgba(168, 85, 247, 0.5);
      }
      .cta::before {
        content: '';
        position: absolute;
        inset: -2px;
        z-index: -1;
        border-radius: inherit;
        padding: 2px;
        background: conic-gradient(from var(--angle), var(--red), var(--purple), var(--blue), var(--purple), var(--red));
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: borderSpin 4s linear infinite;
      }
      .cta::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        opacity: 0;
        transition: opacity 0.25s;
        background: radial-gradient(120px circle at var(--px, 50%) var(--py, 50%), rgba(216, 180, 254, 0.3), transparent 62%);
      }
      .cta__arrow {
        transition: transform 0.25s var(--ease);
      }
      .cta:hover,
      .cta:focus-visible {
        transform: translateY(-2px) scale(1.04);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 14px 44px -8px rgba(168, 85, 247, 0.75);
      }
      .cta:hover::after,
      .cta:focus-visible::after {
        opacity: 1;
      }
      .cta:hover .cta__arrow,
      .cta:focus-visible .cta__arrow {
        transform: translateX(6px);
      }
      .cta:active {
        transform: scale(0.98);
        transition-duration: 0.15s;
      }
      .cta:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 5px;
      }
      @keyframes borderSpin {
        to {
          --angle: 360deg;
        }
      }

      .cover:has(.cta:hover) .logo__glow--violet,
      .cover:has(.cta:focus-visible) .logo__glow--violet {
        opacity: 0.7;
      }

      .cover__hint {
        margin: 0.35em 0 0;
        font-size: clamp(0.68rem, 1.5vmin, 0.8rem);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        /* #ink-hint a opacidad .8 ≈ 7:1 sobre el fondo (AA holgado). */
        color: var(--ink-hint);
        opacity: 0.9;
        animation: blink 3s ease-in-out infinite;
      }
      @keyframes blink {
        0%,
        100% {
          opacity: 0.8;
        }
        50% {
          opacity: 1;
        }
      }

      .cover__alt {
        margin: 0.15em 0 0;
        font-size: clamp(0.7rem, 1.6vmin, 0.85rem);
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
      .cover__alt a {
        color: var(--ink-dim);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .cover__alt a:hover,
      .cover__alt a:focus-visible {
        color: var(--ink);
        border-bottom-color: var(--ink-dim);
      }
      .cover__alt a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 4px;
        border-radius: 2px;
      }

      @keyframes riseIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ---------- SALIDA ---------- */
      .cover.is-leaving {
        opacity: 0;
        filter: blur(6px);
        pointer-events: none;
      }
      .cover.is-leaving .logo {
        transform: scale(1.6);
        transition: transform 0.6s var(--ease);
      }

      /* ---------- RETRATO: foto vertical, choque arriba/abajo ---------- */
      @media (max-aspect-ratio: 1/1) {
        :root {
          --logo-size: clamp(150px, 34vmin, 300px);
        }
        .cover__half--red {
          clip-path: inset(0 0 50% 0);
          animation-name: clashTop;
        }
        .cover__half--blue {
          clip-path: inset(50% 0 0 0);
          animation-name: clashBottom;
        }
        .cover__half--red::after {
          background: linear-gradient(to bottom, rgba(255, 46, 77, 0.28), transparent 70%);
        }
        .cover__half--blue::after {
          background: linear-gradient(to top, rgba(46, 139, 255, 0.28), transparent 70%);
        }
        .cover__half img {
          object-position: 50% 60%;
        }
        .seam {
          left: -10%;
          right: -10%;
          top: 50%;
          bottom: auto;
          width: auto;
          height: 3px;
          translate: 0 -50%;
          background: linear-gradient(to right, transparent, var(--purple-hot) 22%, #fff 50%, var(--purple-hot) 78%, transparent);
        }
        /* Tapa el reflejo difuso del borde izquierdo cerca del suelo. */
        .cover__scrim--spot {
          background:
            radial-gradient(ellipse at center, rgba(5, 6, 12, 0.55), transparent 62%),
            linear-gradient(to right, rgba(5, 6, 12, 0.8), transparent 22%);
        }
        .spark:nth-child(1) { left: 30%; top: 10%; --dx: 4vw; --dy: 10vh; }
        .spark:nth-child(2) { left: 60%; top: 16%; --dx: -3vw; --dy: 8vh; }
        .spark:nth-child(3) { left: 45%; top: 6%; --dx: 2vw; --dy: 12vh; }
        .spark:nth-child(4) { left: 70%; top: 24%; --dx: -5vw; --dy: 7vh; }
        .spark:nth-child(5) { left: 28%; top: 88%; --dx: 5vw; --dy: -10vh; }
        .spark:nth-child(6) { left: 62%; top: 82%; --dx: -4vw; --dy: -8vh; }
        .spark:nth-child(7) { left: 48%; top: 94%; --dx: 1vw; --dy: -12vh; }
        .spark:nth-child(8) { left: 74%; top: 76%; --dx: -6vw; --dy: -7vh; }
      }
      @keyframes clashTop {
        from {
          transform: translateY(-2.5%);
        }
        to {
          transform: translateY(0);
        }
      }
      @keyframes clashBottom {
        from {
          transform: translateY(2.5%);
        }
        to {
          transform: translateY(0);
        }
      }

      /* ---------- RESPONSIVE SIN SCROLL ---------- */
      @media (max-height: 460px) and (orientation: landscape) {
        :root {
          --logo-size: clamp(110px, 34vmin, 200px);
        }
        .cover__tag,
        .cover__hint,
        .cover__alt {
          display: none;
        }
        .cover__top {
          top: max(10px, env(safe-area-inset-top));
        }
        .cover__bottom {
          bottom: max(10px, env(safe-area-inset-bottom));
        }
        .cover__team {
          top: calc(50% + 64px);
          font-size: 0.7rem;
        }
        .cta {
          padding: 0.6em 1.8em;
          min-height: 40px;
        }
      }
      @media (max-width: 380px) {
        .cover__brand {
          letter-spacing: 0.26em;
          text-indent: 0.26em;
        }
        .cover__tag {
          letter-spacing: 0.3em;
          text-indent: 0.3em;
        }
      }
      @media (min-aspect-ratio: 21/9) {
        :root {
          --logo-size: clamp(150px, 46vh, 520px);
        }
      }
      @media (hover: none) {
        .logo {
          transform: none;
        }
      }
      @media (max-width: 480px) {
        .logo__glow {
          filter: blur(clamp(20px, 5vmin, 40px));
        }
        .aurora {
          filter: blur(clamp(40px, 8vmax, 90px));
        }
      }

      /* ---------- ACCESIBILIDAD ---------- */
      @media (prefers-reduced-transparency: reduce) {
        .cta {
          background: #080c16;
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
        }
        .noise,
        .scan {
          display: none;
        }
      }
      @media (prefers-contrast: more) {
        .grid,
        .noise,
        .scan,
        .cover__sparks,
        .seam {
          display: none;
        }
        .cta {
          background: #000;
        }
        .cover__brand {
          background: none;
          color: #fff;
        }
        .cover__team {
          background: none;
          color: #fff;
        }
      }
      @media (forced-colors: active) {
        .cover__bg,
        .cover__photo,
        .logo__glow,
        .logo__ring,
        .hud,
        .seam,
        .cover__sparks,
        .bars {
          display: none;
        }
        .cta {
          border: 2px solid ButtonText;
          background: ButtonFace;
          color: ButtonText;
        }
        .cover__brand,
        .cover__team {
          color: CanvasText;
          background: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
        .aurora--red {
          transform: translate(-62%, -50%);
        }
        .aurora--blue {
          transform: translate(62%, -50%);
        }
        /* Estado final directo: logo violeta + PURPLE TEAM + botón. */
        .cover__team {
          opacity: 1;
          letter-spacing: 0.34em;
          text-indent: 0.34em;
        }
        .logo .logo__img {
          filter:
            drop-shadow(0 0 18px rgba(168, 85, 247, 0.9))
            drop-shadow(0 0 46px rgba(168, 85, 247, 0.55));
        }
        .logo__glow--violet {
          opacity: 0.55;
        }
      }
    </style>
    <noscript>
      <style>
        /* Sin JS: estado final estático (foto, logo violeta, equipo, botón). */
        .cover__team {
          opacity: 1;
          letter-spacing: 0.34em;
          text-indent: 0.34em;
        }
        .logo .logo__img {
          filter:
            drop-shadow(0 0 18px rgba(168, 85, 247, 0.9))
            drop-shadow(0 0 46px rgba(168, 85, 247, 0.55));
        }
        .logo__glow--violet {
          opacity: 0.55;
        }
      </style>
    </noscript>
  </head>
  <body>
    <main class="cover" id="cover">
      <div class="cover__bg" aria-hidden="true">
        <i class="aurora aurora--red"></i>
        <i class="aurora aurora--blue"></i>
