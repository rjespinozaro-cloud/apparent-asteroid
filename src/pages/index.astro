        <i class="noise"></i>
        <i class="scan"></i>
        <i class="vignette"></i>
      </div>

      <div class="cover__photo" id="photo" aria-hidden="true">
        <div class="cover__half cover__half--red">
          <picture>
            <source srcset={`${base}hero/hero-tall.avif`} type="image/avif" media="(max-aspect-ratio: 1/1)" />
            <source srcset={`${base}hero/hero-tall.webp`} type="image/webp" media="(max-aspect-ratio: 1/1)" />
            <source srcset={`${base}hero/hero-wide.avif`} type="image/avif" />
            <source srcset={`${base}hero/hero-wide.webp`} type="image/webp" />
            <img src={`${base}hero/hero-wide.webp`} width="1024" height="572" alt="" fetchpriority="high" decoding="async" data-hero-img />
          </picture>
        </div>
        <div class="cover__half cover__half--blue">
          <picture>
            <source srcset={`${base}hero/hero-tall.avif`} type="image/avif" media="(max-aspect-ratio: 1/1)" />
            <source srcset={`${base}hero/hero-tall.webp`} type="image/webp" media="(max-aspect-ratio: 1/1)" />
            <source srcset={`${base}hero/hero-wide.avif`} type="image/avif" />
            <source srcset={`${base}hero/hero-wide.webp`} type="image/webp" />
            <img src={`${base}hero/hero-wide.webp`} width="1024" height="572" alt="" fetchpriority="high" decoding="async" data-hero-img />
          </picture>
        </div>
      </div>
      <div class="cover__scrim cover__scrim--top" aria-hidden="true"></div>
      <div class="cover__scrim cover__scrim--bottom" aria-hidden="true"></div>
      <div class="cover__scrim cover__scrim--spot" aria-hidden="true"></div>
      <i class="seam" id="seam" aria-hidden="true"></i>
