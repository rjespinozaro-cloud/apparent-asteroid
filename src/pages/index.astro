        <i class="logo__glow logo__glow--violet" aria-hidden="true"></i>
        <img
          class="logo__img"
          src={`${base}logo.png`}
          width="640"
          height="320"
          alt="JOANIX GUIDES"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <p class="cover__team" id="team" data-text="PURPLE TEAM">Purple Team</p>

      <footer class="cover__bottom">
        <a class="cta" id="enter" href={`${base}inicio/`}>
          <span class="cta__label">Entrar</span>
          <span class="cta__arrow" aria-hidden="true">→</span>
        </a>
        <p class="cover__hint">Enter o clic para continuar</p>
        <p class="cover__alt"><a href={`${base}guias/`}>Ir directamente a las guías</a></p>
      </footer>
    </main>

    <script>
      // @ts-nocheck — micro-script progresivo verificado en navegador; el tipado estricto vive en src/.
      (function () {
        var coverNode = document.getElementById('cover');
        var enterNode = document.getElementById('enter');
        if (!(coverNode instanceof HTMLElement) || !(enterNode instanceof HTMLAnchorElement)) return;
        const cover = coverNode;
        const destino = enterNode.href;

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        var portrait = window.matchMedia('(max-aspect-ratio: 1/1)').matches;
        var conexion = navigator.connection || {};
        var ahorroDatos = conexion.saveData === true || /^(slow-2g|2g)$/.test(conexion.effectiveType || '');
        var tactil = window.matchMedia('(pointer: coarse)').matches;
        // En móvil o con ahorro de datos/conexión lenta: destello CSS, sin canvas.
        var sinCanvas = reduceMotion || ahorroDatos || tactil;
        var saliendo = false;

        // Sincronía con el CSS: el rayo cae en el instante --t-hit.
        var tHit = parseFloat(window.getComputedStyle(cover).getPropertyValue('--t-hit')) * 1000;
        if (!(tHit > 0)) tHit = 1350;

        // Si la foto falla, cae al fondo aurora+grid sin romperse.
        var photo = document.getElementById('photo');
        Array.prototype.forEach.call(document.querySelectorAll('[data-hero-img]'), function (img) {
          img.addEventListener('error', function () {
            if (photo instanceof HTMLElement) photo.classList.add('is-missing');
          });
        });

        function salir() {
          if (saliendo) return;
          saliendo = true;
          if (reduceMotion) {
            window.location.href = destino;
            return;
          }
          cover.classList.add('is-leaving');
          window.setTimeout(function () {
            window.location.href = destino;
          }, 500);
        }

        enterNode.addEventListener('click', function (evento) {
          evento.preventDefault();
          salir();
        });

        document.addEventListener('keydown', function (evento) {
          if (evento.key !== 'Enter' && evento.key !== ' ') return;
          if (evento.target instanceof HTMLElement) {
            var tag = evento.target.tagName;
            if (tag === 'A' || tag === 'BUTTON') return;
          }
          evento.preventDefault();
          salir();
        });

        /* ---------- RAYO PROCEDURAL (canvas único, DPR<=2) ---------- */
        var canvasNode = document.getElementById('bolt');
        const lienzo = canvasNode instanceof HTMLCanvasElement ? canvasNode : null;
        const trazo = !sinCanvas && lienzo ? lienzo.getContext('2d') : null;

        /**
         * @param {HTMLCanvasElement} elCanvas
         * @param {CanvasRenderingContext2D} elCtx
         */
        function dimensionar(elCanvas, elCtx) {
          void elCtx;
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          var rect = cover.getBoundingClientRect();
          elCanvas.width = Math.max(1, Math.round(rect.width * dpr));
          elCanvas.height = Math.max(1, Math.round(rect.height * dpr));
          return { w: elCanvas.width, h: elCanvas.height, dpr: dpr };
        }

        /**
         * Midpoint displacement hacia el logo, con ramificaciones.
         * @param {CanvasRenderingContext2D} ctx2d
         * @param {number} x0
         * @param {number} y0
         * @param {number} x1
         * @param {number} y1
         * @param {number} semilla
         * @param {number} ramas
         */
        function trazarRayo(ctx2d, x0, y0, x1, y1, semilla, ramas) {
          var puntos = [{ x: x0, y: y0 }];
          var segmentos = 6;
          for (var i = 1; i <= segmentos; i++) {
            var t = i / segmentos;
            var dispersion = (1 - Math.abs(t - 0.5) * 1.4) * 46 * semilla;
            puntos.push({
              x: x0 + (x1 - x0) * t + (Math.random() - 0.5) * dispersion,
              y: y0 + (y1 - y0) * t + (Math.random() - 0.5) * dispersion * 0.4,
            });
          }
          /**
           * @param {Array<{x:number,y:number}>} pts
           * @param {number} ancho
           * @param {string} estilo
           * @param {string} sombra
           * @param {number} blur
           */
          var dibujar = function (pts, ancho, estilo, sombra, blur) {
            ctx2d.beginPath();
            ctx2d.moveTo(pts[0].x, pts[0].y);
            for (var j = 1; j < pts.length; j++) ctx2d.lineTo(pts[j].x, pts[j].y);
            ctx2d.lineWidth = ancho;
            ctx2d.strokeStyle = estilo;
            ctx2d.shadowColor = sombra;
            ctx2d.shadowBlur = blur;
            ctx2d.lineCap = 'round';
            ctx2d.lineJoin = 'round';
            ctx2d.stroke();
          };
          dibujar(puntos, 7, 'rgba(139,92,246,0.55)', 'rgba(139,92,246,0.9)', 26);
          dibujar(puntos, 3, 'rgba(46,139,255,0.8)', 'rgba(46,139,255,0.9)', 14);
          dibujar(puntos, 1.4, 'rgba(255,255,255,0.95)', 'rgba(255,255,255,1)', 8);
          for (var r = 0; r < ramas; r++) {
            var idx = 1 + Math.floor(Math.random() * (puntos.length - 2));
            var base = puntos[idx];
            var ang = (Math.random() < 0.5 ? -1 : 1) * (0.4 + Math.random() * 0.5);
            var len = 40 + Math.random() * 70;
            dibujar(
              [base, { x: base.x + Math.cos(ang) * len, y: base.y + Math.abs(Math.sin(ang)) * len }],
              1.6,
              'rgba(255,46,77,0.75)',
              'rgba(255,46,77,0.9)',
              10
            );
          }
        }

        var rafBolt = 0;
        function pararRayo() {
          if (rafBolt) window.cancelAnimationFrame(rafBolt);
          rafBolt = 0;
          if (trazo && lienzo) trazo.clearRect(0, 0, lienzo.width, lienzo.height);
        }

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) pararRayo();
        });

        /**
         * @param {CanvasRenderingContext2D} c
         * @param {{ w: number, h: number, dpr: number }} dims
         * @param {number} lx
         * @param {number} ly
         * @param {number} sx
         * @param {number} semilla
         */
        function animarBolt(c, dims, lx, ly, sx, semilla) {
          var fases = [90, 70, 150, 60, 220];
          var i = 0;
          var visible = true;
          var ultimo = 0;
          var t0 = performance.now();
          /**
           * @param {number} ahora
           */
          var frame = function (ahora) {
            if (document.hidden) {
              pararRayo();
              return;
            }
            if (ahora - ultimo > fases[Math.min(i, fases.length - 1)]) {
              ultimo = ahora;
              visible = !visible;
              i++;
              c.clearRect(0, 0, dims.w, dims.h);
              if (visible) trazarRayo(c, sx, -20, lx, ly, semilla, 3);
              else if (i >= fases.length) {
                pararRayo();
                programarArcos();
                return;
              }
            }
            if (performance.now() - t0 < 1400) rafBolt = window.requestAnimationFrame(frame);
            else {
              pararRayo();
              programarArcos();
            }
          };
          rafBolt = window.requestAnimationFrame(frame);
        }

        // Bolt completo del choque: parpadea 3 veces y se apaga.
        function rayoChoque() {
          if (!trazo || !lienzo) {
            impacto();
            return;
          }
          if (document.hidden) return;
          var dims = dimensionar(lienzo, trazo);
          var rect = cover.getBoundingClientRect();
          var logo = document.getElementById('logo');
          var lr = logo instanceof HTMLElement ? logo.getBoundingClientRect() : rect;
          var lx = (lr.left + lr.width / 2 - rect.left) * dims.dpr;
          var ly = (lr.top + lr.height / 2 - rect.top) * dims.dpr;
          var sx = portrait ? dims.w * 0.5 : dims.w * (0.55 + Math.random() * 0.1);
          animarBolt(trazo, dims, lx, ly, sx, 0.7 + Math.random() * 0.6);
        }

        // Mini-arcos ocasionales: ráfagas cortas cada 8-12 s, sin loop permanente.
        var temporizadorArcos = 0;
        function programarArcos() {
          window.clearTimeout(temporizadorArcos);
          temporizadorArcos = window.setTimeout(function () {
            if (document.hidden || saliendo || !trazo || !lienzo) {
              programarArcos();
              return;
            }
            var dims = dimensionar(lienzo, trazo);
            var rect = cover.getBoundingClientRect();
            var logo = document.getElementById('logo');
            var lr = logo instanceof HTMLElement ? logo.getBoundingClientRect() : rect;
            var dpr = dims.dpr;
            var lx = (lr.left + lr.width / 2 - rect.left) * dpr;
            var ly = (lr.top - rect.top) * dpr;
            var t0 = performance.now();
            var mini = function () {
              if (document.hidden || saliendo) {
                pararRayo();
                programarArcos();
                return;
              }
              trazo.clearRect(0, 0, dims.w, dims.h);
              trazarRayo(trazo, lx + (Math.random() - 0.5) * 60, ly - 120 * dpr, lx, ly, 0.5, 1);
              if (performance.now() - t0 < 700) rafBolt = window.requestAnimationFrame(mini);
              else {
                pararRayo();
                programarArcos();
              }
            };
            rafBolt = window.requestAnimationFrame(mini);
          }, 8000 + Math.random() * 4000);
        }

        /* ---------- SECUENCIA DE ENTRADA (~3 s) ---------- */
        var flash = document.getElementById('flash');

        function impacto() {
          cover.classList.add('is-impact');
          var logo = document.getElementById('logo');
          if (logo instanceof HTMLElement) logo.classList.add('is-lit');
          if (flash instanceof HTMLElement) {
            flash.classList.add('is-on');
            window.setTimeout(function () {
              flash.classList.remove('is-on');
            }, 140);
          }
          cover.classList.add('is-shake');
          window.setTimeout(function () {
            cover.classList.remove('is-shake');
          }, 550);
        }

        function secuencia() {
          if (reduceMotion) {
            // Estado final directo: logo violeta + PURPLE TEAM + botón.
            cover.classList.add('is-impact');
            var logo = document.getElementById('logo');
            if (logo instanceof HTMLElement) logo.classList.add('is-lit');
            return;
          }
          if (sinCanvas) {
            // Destello CSS simple en lugar del rayo.
            window.setTimeout(function () {
              impacto();
              programarArcos();
            }, tHit);
            return;
          }
          window.setTimeout(function () {
            rayoChoque();
            impacto();
          }, tHit);
        }

        if (document.readyState === 'complete') secuencia();
        else window.addEventListener('load', secuencia, { once: true });

        /* ---------- PARALLAX SUTIL (solo puntero fino) ---------- */
        // Brillo del botón que sigue al puntero.
        enterNode.addEventListener('pointermove', function (evento) {
          var r = enterNode.getBoundingClientRect();
          if (r.width > 0) enterNode.style.setProperty('--px', (((evento.clientX - r.left) / r.width) * 100).toFixed(1) + '%');
          if (r.height > 0) enterNode.style.setProperty('--py', (((evento.clientY - r.top) / r.height) * 100).toFixed(1) + '%');
        });
        if (fineHover && !reduceMotion) {
          var logoNode = document.getElementById('logo');
          if (logoNode instanceof HTMLElement) {
            (function (logoEl) {
              var raf = 0;
              var mx = 0;
              var my = 0;
              cover.addEventListener('pointermove', function (evento) {
                var x = (evento.clientX / window.innerWidth - 0.5) * 2;
                var y = (evento.clientY / window.innerHeight - 0.5) * 2;
                mx = Math.max(-1, Math.min(1, x));
                my = Math.max(-1, Math.min(1, y));
                if (!raf) {
                  raf = window.requestAnimationFrame(function () {
                    // La variable vive en .logo (consumidor), no en .cover:
                    // evita recalcular estilos de todo el subárbol en cada frame.
                    logoEl.style.setProperty('--mx', mx.toFixed(3));
                    logoEl.style.setProperty('--my', my.toFixed(3));
                    raf = 0;
                  });
                }
              });
            })(logoNode);
          }
        }
      })();
    </script>
    <noscript>
      <style>
        /* Sin JS: estado final estático (foto, logo violeta, equipo, botón). */
        .cover__team {
          opacity: 1;
          letter-spacing: 0.34em;
          text-indent: 0.34em;
        }
        .logo .logo__img {
          filter:
            drop-shadow(0 0 18px rgba(168, 85, 247, 0.9))
            drop-shadow(0 0 46px rgba(168, 85, 247, 0.55));
        }
        .logo__glow--violet {
          opacity: 0.55;
        }
      </style>
    </noscript>
  </body>
</html>
