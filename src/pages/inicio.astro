---
import Base from '../layouts/Base.astro';
import AsistenteFlotante from '../components/AsistenteFlotante.astro';
import TarjetaGuia from '../components/TarjetaGuia.astro';
import TarjetaRuta from '../components/TarjetaRuta.astro';
import {
  getDatabase,
  listarGuiasDestacadas,
  listarHerramientasDestacadas,
  listarRutasConTipologia,
  listarUltimasGuias,
} from '../lib/db.js';
import { plural } from '../lib/utils/texto.js';
import { env } from 'cloudflare:workers';
import bricolage600 from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-600-normal.woff2?url';
import plex400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-500-normal.woff2?url';
import plex600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import mono400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';

const fuentesHero = [bricolage600, plex400, plex500, plex600, mono400];

export const prerender = false;

const database = getDatabase(env);
const [ultimas, herramientasDestacadas, rutasConTipologia, guiasDestacadas] = await Promise.all([
  listarUltimasGuias(database, 6),
  listarHerramientasDestacadas(database),
  listarRutasConTipologia(database, { destacadas: true }),
  listarGuiasDestacadas(database, 4),
]);

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

// Datos del carrusel del hero: un único lugar para imágenes, textos y CTAs.
const slides = [
  {
    id: '01-bienvenida',
    tono: 'violet',
    kicker: 'Bienvenida',
    apoyo: 'Guías, rutas y herramientas para practicar seguridad desde el primer día.',
    cta: 'Explorar guías',
    href: `${base}guias/`,
  },
  {
    id: '02-red-team',
    tono: 'red',
    kicker: 'RED',
    apoyo: 'Reconocimiento, enumeración y explotación con autorización explícita.',
    cta: 'Ver guías RED',
    href: `${base}guias/?equipo=red`,
  },
  {
    id: '03-blue-team',
    tono: 'blue',
    kicker: 'BLUE',
    apoyo: 'Detección, validación y endurecimiento para equipos defensivos.',
    cta: 'Ver guías BLUE',
    href: `${base}guias/?equipo=blue`,
  },
  {
    id: '04-laboratorio',
    tono: 'violet',
    kicker: 'Laboratorio',
    apoyo: 'Practica en un entorno controlado, con cada paso explicado.',
    cta: 'Ver rutas',
    href: `${base}rutas/`,
  },
  {
    id: '05-purple-team',
    tono: 'violet',
    kicker: 'Purple team',
    apoyo: 'Ataque y defensa sobre el mismo escenario para aprender más rápido.',
    cta: 'Conocer las rutas',
    href: `${base}rutas/`,
  },
] as const;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base clase="page-enter">
  <Fragment slot="cabecera">
    {fuentesHero.map((fuente) => (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={fuente} />
    ))}
    <link
      rel="preload"
      as="image"
      type="image/avif"
      fetchpriority="high"
      imagesizes="100vw"
      imagesrcset={`${base}inicio-hero/01-bienvenida-960.avif 960w, ${base}inicio-hero/01-bienvenida-1024.avif 1024w`}
      href={`${base}inicio-hero/01-bienvenida-1024.avif`}
    />
  </Fragment>

  <section
    class="portada portada--hero"
    data-carrusel
    aria-labelledby="inicio-titulo"
    aria-roledescription="carrusel"
  >
    <div class="portada--hero__bg" aria-hidden="true">
      {slides.map((slide, i) => (
        <div
          class:list={['portada--hero__slide', i === 0 && 'is-activa']}
          data-slide
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${slides.length}`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <picture>
            <source
              type="image/avif"
              sizes="100vw"
              {...(i === 0
                ? {
                    srcset: `${base}inicio-hero/${slide.id}-960.avif 960w, ${base}inicio-hero/${slide.id}-1024.avif 1024w`,
                  }
                : {
                    'data-srcset': `${base}inicio-hero/${slide.id}-960.avif 960w, ${base}inicio-hero/${slide.id}-1024.avif 1024w`,
                  })}
            />
            <source
              type="image/webp"
              sizes="100vw"
              {...(i === 0
                ? {
                    srcset: `${base}inicio-hero/${slide.id}-960.webp 960w, ${base}inicio-hero/${slide.id}-1024.webp 1024w`,
                  }
                : {
                    'data-srcset': `${base}inicio-hero/${slide.id}-960.webp 960w, ${base}inicio-hero/${slide.id}-1024.webp 1024w`,
                  })}
            />
            <img
              src={i === 0 ? `${base}inicio-hero/${slide.id}-1024.webp` : undefined}
              data-src={i === 0 ? undefined : `${base}inicio-hero/${slide.id}-1024.webp`}
              width="1024"
              height="572"
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding={i === 0 ? 'sync' : 'async'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </picture>
        </div>
      ))}
      <div class="portada--hero__scrim"></div>
    </div>

    <div class="portada--hero__contenido">
      <p class="portada--hero__kicker">Cybersecurity Knowledge Lab</p>
      <h1 id="inicio-titulo">Aprende seguridad ofensiva y defensiva desde una misma plataforma.</h1>

      <div class="portada--hero__slides" data-carrusel-vivo aria-live="off" aria-atomic="true">
        {slides.map((slide, i) => (
          <div
            class:list={['portada--hero__slide-texto', i === 0 && 'is-activa']}
            data-slide-texto
            data-tono={slide.tono}
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${slides.length}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
            inert={i === 0 ? undefined : true}
          >
            <p class="portada--hero__kicker">{slide.kicker}</p>
            <p class="portada--hero__apoyo">{slide.apoyo}</p>
            <a class="portada--hero__cta" href={slide.href}>{slide.cta}</a>
          </div>
        ))}
      </div>

      <form class="buscador" method="get" action={`${base}buscar/`} role="search">
        <label class="visualmente-oculto" for="buscar-inicio">Buscar guías</label>
        <input
          id="buscar-inicio"
          name="q"
          type="search"
          maxlength="80"
          autocomplete="off"
          enterkeyhint="search"
          placeholder="Buscar guías por texto…"
        />
        <button type="submit" class="boton--premium">Buscar</button>
      </form>

      <div class="portada--hero__controles">
        <button
          type="button"
          class="portada--hero__control"
          data-carrusel-prev
          aria-label="Diapositiva anterior"
        >
          <span aria-hidden="true">‹</span>
        </button>
        <div class="portada--hero__indicadores" role="group" aria-label="Ir a una diapositiva">
          {slides.map((_, i) => (
            <button
              type="button"
              class="portada--hero__indicador"
              data-indicador
              aria-label={`Ir a la diapositiva ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <span class="portada--hero__indicador-pista">
                <span class="portada--hero__indicador-barra"></span>
              </span>
            </button>
          ))}
        </div>
        <button
          type="button"
          class="portada--hero__control"
          data-carrusel-next
          aria-label="Diapositiva siguiente"
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </section>

  <section class="continua contenedor" aria-label="Continúa donde lo dejaste" data-continua data-base={base} hidden>
    <a class="boton--ghost continua__enlace" data-continua-enlace href={`${base}guias/`}>
      <span class="continua__etiqueta">Continúa:</span>
      <span class="continua__titulo" data-continua-titulo>Catálogo</span>
      <span aria-hidden="true">→</span>
    </a>
  </section>

  {rutasConTipologia.length > 0 && (
    <section class="seccion seccion--rutas reveal" aria-labelledby="rutas-titulo">
      <div class="seccion__cabecera">
        <div>
          <h2 class="seccion__titulo" id="rutas-titulo">Rutas de aprendizaje</h2>
        </div>
      </div>
      <div class:list={['rutas-conjunto', rutasConTipologia.length === 1 && 'rutas-conjunto--una']}>
        <ul class="rejilla-tarjetas">
          {rutasConTipologia.map(({ ruta, tipologia }) => (
            <li>
              <TarjetaRuta ruta={ruta} tipologia={tipologia} primerPaso={tipologia.primer_paso} />
            </li>
          ))}
        </ul>
        {rutasConTipologia.length === 1 && (
          <aside class="rutas-ayuda" aria-label="Cómo funcionan las rutas">
            <h2>Cómo funcionan las rutas</h2>
            <p>
              Las rutas ordenan guías publicadas en pasos numerados. Cada paso
              enlaza una guía real; si aún no está publicada verás
              «Próximamente». Avanza en orden: del laboratorio a la defensa.
            </p>
          </aside>
        )}
      </div>
    </section>
  )}

  {guiasDestacadas.length > 0 && (
    <section class="seccion reveal" aria-labelledby="destacadas-titulo">
      <div class="seccion__cabecera">
        <div>
          <h2 class="seccion__titulo" id="destacadas-titulo">Guías destacadas</h2>
        </div>
              </div>
      <ul class="rejilla-tarjetas reveal--stagger">
        {guiasDestacadas.map((guia) => (
          <li><TarjetaGuia guia={guia} /></li>
        ))}
      </ul>
    </section>
  )}

  <section class="seccion seccion--equipos reveal" aria-labelledby="equipos-titulo">
    <div class="seccion__cabecera">
      <div>
        <h2 class="seccion__titulo" id="equipos-titulo">El mismo escenario, dos lecturas</h2>
      </div>
    </div>

    <div class="rejilla-equipos reveal--stagger">
      <article class="equipo equipo--red">
        <p class="equipo__clave">RED</p>
        <h3 class="equipo__titulo">Ofensiva</h3>
        <p>
          Reconocimiento, enumeración y explotación con autorización explícita. El adelanto de cada guía
          es público; el recorrido completo va en PDF.
        </p>
        <a class="boton--ghost chip--red chip--pulse" href={`${base}guias/?equipo=red`}>Ver guías RED</a>
      </article>

      <article class="equipo equipo--blue">
        <p class="equipo__clave">BLUE</p>
        <h3 class="equipo__titulo">Defensa</h3>
        <p>
          Detección, validación y endurecimiento. Guías gratuitas y abiertas para que el equipo defensivo
          pueda practicar sin fricción.
        </p>
        <a class="boton--ghost chip--blue chip--pulse" href={`${base}guias/?equipo=blue`}>Ver guías BLUE</a>
      </article>
    </div>
  </section>

  {herramientasDestacadas.length > 0 && (
    <section class="seccion reveal" aria-labelledby="herramientas-titulo">
      <div class="seccion__cabecera">
        <div>
          <h2 class="seccion__titulo" id="herramientas-titulo">Herramientas para practicar</h2>
        </div>
              </div>
      {herramientasDestacadas.length < 3 ? (
        <div class="rejilla-tarjetas">
          {herramientasDestacadas.map((item) => (
            <article class="tarjeta tarjeta--destacada">
              <h3 class="tarjeta__titulo">
                <a href={`${base}herramientas/${item.herramienta}/`}>{item.nombre}</a>
              </h3>
              <p class="tarjeta__meta">
                <span>{plural(item.total, 'guía', 'guías')}</span>
                {item.blue > 0 && <span>{plural(item.blue, 'defensiva', 'defensivas')} (BLUE)</span>}
                {item.red > 0 && <span>{plural(item.red, 'ofensiva', 'ofensivas')} (RED)</span>}
              </p>
            </article>
          ))}
        </div>
      ) : (
        <ul class="lista-herramientas--inicio">
          {herramientasDestacadas.map((item) => (
            <li class="lista-herramientas__item">
              <a href={`${base}herramientas/${item.herramienta}/`}>{item.nombre}</a>
              <span class="lista-herramientas__conteo">{plural(item.total, 'guía', 'guías')}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  {ultimas.length > 0 && (
    <section class="seccion reveal" aria-labelledby="ultimas-titulo">
      <div class="seccion__cabecera">
        <div>
          <h2 class="seccion__titulo" id="ultimas-titulo">Últimas guías</h2>
        </div>
              </div>
      <ul class="rejilla-tarjetas reveal--stagger">
        {ultimas.map((guia) => (
          <li><TarjetaGuia guia={guia} /></li>
        ))}
      </ul>
    </section>
  )}

  <AsistenteFlotante />
</Base>

<script>
  import '../scripts/continua.js';
  import '../scripts/hero-carrusel.js';
</script>
