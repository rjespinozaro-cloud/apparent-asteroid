---
/**
 * /perfil/ — el planeta de herramientas.
 *
 * Es una página pública: no hay cuenta ni sesión. Los niveles se guardan en
 * el navegador (ver src/scripts/planeta.js) y el servidor solo aporta el
 * catálogo de herramientas y su equipo, deducido de las guías publicadas.
 */
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Planeta from '../../components/Planeta.astro';
import { getDatabase, listarGuiasPublicadasParaPerfil, listarHerramientasPlaneta, listarRutasPorHerramienta } from '../../lib/db.js';
import { plural } from '../../lib/utils/texto.js';
import { env } from 'cloudflare:workers';
import '../../styles/perfil.css';

export const prerender = false;

const database = getDatabase(env);
const [herramientasBase, guiasPorHerramienta, rutasPorHerramienta] = await Promise.all([
  listarHerramientasPlaneta(database),
  listarGuiasPublicadasParaPerfil(database),
  listarRutasPorHerramienta(database),
]);

const herramientas = herramientasBase.map((herramienta) => {
  const guiasLista = guiasPorHerramienta.get(herramienta.slug) ?? [];
  return {
    ...herramienta,
    guias: guiasLista.length,
    guiasLista,
    rutas: rutasPorHerramienta.get(herramienta.slug) ?? [],
  };
});

const conGuias = herramientas.filter((herramienta) => herramienta.guias > 0).length;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const descripcion = conGuias > 0
  ? `Tu perfil de ciberseguridad como un sistema solar: ${plural(herramientas.length, 'herramienta', 'herramientas')} en órbita y tu progreso real con las guías completadas.`
  : 'Tu perfil de ciberseguridad como un sistema solar: descubre las herramientas y el nivel que dan tus guías completadas.';

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base
  title="Mi planeta de herramientas | JOANIX"
  description={descripcion}
  ogType="website"
>
  <header class="perfil-hero contenedor">
    <Migas clase="" items={[{ texto: 'Inicio', href: `${base}inicio/` }, { texto: 'Mi planeta' }]} />

    <h1>Tu <em>planeta</em> de herramientas</h1>

    <p class="entradilla">
      Cada herramienta es un cuerpo en órbita. Azul defiende, rojo ataca y los de dos colores sirven a los dos
      equipos. Cuanto más avanzas en sus guías, más grande se ve.
    </p>

    <p class="perfil-nota">
      Tu progreso se guarda <strong>solo en este navegador</strong>. El nivel de cada herramienta sale de las
      guías que marques como completadas; prácticas, examen y juegos todavía no están disponibles. Todavía no
      hay cuentas de visitante: si cambias de dispositivo o borras los datos del navegador, el progreso empieza
      de cero.
    </p>

    <p class="perfil-nota">
      {plural(herramientas.length, 'herramienta', 'herramientas')} en el catálogo
      {conGuias > 0 ? ` · ${conGuias} con guías publicadas` : ' · todavía sin guías publicadas'}.
      El equipo de cada una se deduce de sus guías; mientras no las haya, del temario.
    </p>
  </header>

  <Planeta herramientas={herramientas} />
</Base>

<script>
  import '../../scripts/planeta.js';
</script>
