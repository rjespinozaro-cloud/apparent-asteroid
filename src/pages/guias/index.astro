---
import Base from '../../layouts/Base.astro';
import AsistenteFlotante from '../../components/AsistenteFlotante.astro';
import AssistantMascot from '../../components/AssistantMascot.astro';
import TarjetaGuia from '../../components/TarjetaGuia.astro';
import { contarGuiasPublicadas, getDatabase, listarGuiasDestacadas, listarGuiasPublicadas, listarHerramientasPublicadas } from '../../lib/db.js';
import { opcion } from '../../lib/validar.js';
import { plural } from '../../lib/utils/texto.js';
import { nombreEquipo, nombreHerramienta, nombreNivel } from '../../lib/vocabulario.js';
import { env } from 'cloudflare:workers';
import '../../styles/guias-listado.css';

export const prerender = false;

const database = getDatabase(env);

/** Filtros validados: nunca se inyecta nada sin pasar por la lista blanca. */
const equipo = opcion(Astro.url.searchParams.get('equipo'), ['blue', 'red']);
const nivel = opcion(Astro.url.searchParams.get('nivel'), ['basico', 'intermedio', 'avanzado']);
const herramienta = (Astro.url.searchParams.get('herramienta') ?? '').toLowerCase().slice(0, 40);
const acceso = opcion(Astro.url.searchParams.get('acceso'), ['gratis', 'pago']);
const pagina = Math.max(1, Number(Astro.url.searchParams.get('pagina')) || 1);
const POR_PAGINA = 12;

const [resultado, herramientas, conteo, recientes] = await Promise.all([
  listarGuiasPublicadas(database, { equipo, nivel, herramienta, acceso, pagina, porPagina: POR_PAGINA }),
  listarHerramientasPublicadas(database),
  contarGuiasPublicadas(database, { equipo, nivel, herramienta, acceso }),
  listarGuiasDestacadas(database, 3),
]);

const { guias, total, pagina: paginaActual, paginas } = resultado;
const hayFiltros = Boolean(equipo || nivel || herramienta || acceso);
const premium = conteo.total - conteo.gratis;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

/**
 * Construye la misma ruta cambiando solo los parámetros indicados.
 * Mantiene los filtros activos al paginar, que es el error clásico de este tipo
 * de listados.
 * @param {Record<string, string | number>} cambios
 */
function enlaceCon(cambios: Record<string, string | number>) {
  const parametros = new URLSearchParams();
  const valores = { equipo, nivel, herramienta, acceso, pagina: paginaActual, ...cambios };
  for (const [clave, valor] of Object.entries(valores)) {
    if (valor && !(clave === 'pagina' && Number(valor) === 1)) parametros.set(clave, String(valor));
  }
  const cadena = parametros.toString();
  return cadena ? `${base}guias/?${cadena}` : `${base}guias/`;
}

const titulo = [
  equipo ? `Guías ${nombreEquipo(equipo)}` : 'Guías',
  nivel ? nombreNivel(nivel) : null,
  herramienta ? nombreHerramienta(herramienta) : null,
].filter(Boolean).join(' · ');

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base
  title={`${titulo} | JOANIX GUIDES`}
  description={`${plural(total, 'guía publicada', 'guías publicadas')} de ciberseguridad en JOANIX GUIDES. Filtra por equipo, nivel y herramienta.`}
>
  <nav class="contenedor" aria-label="Migas de pan">
    <ol class="migas">
      <li><a href={`${base}inicio/`}>Inicio</a></li>
      <li aria-current="page">Guías</li>
    </ol>
  </nav>

  <section class="seccion" aria-labelledby="guias-titulo">
    <div class="contenedor">
      <p class="eyebrow">Catálogo</p>
      <h1 id="guias-titulo">{titulo}</h1>
      <p class="entradilla">
        Conocimiento práctico de ciberseguridad para ofensiva y defensa.
      </p>
      <ul class="catalogo-stats" aria-label={hayFiltros ? 'Resultados del filtro' : 'Totales del catálogo'}>
        <li><strong>{conteo.total}</strong><span>{conteo.total === 1 ? 'guía' : 'guías'}</span></li>
        <li><strong>{conteo.red}</strong><span>RED</span></li>
        <li><strong>{conteo.blue}</strong><span>BLUE</span></li>
        <li><strong>{premium}</strong><span>premium</span></li>
      </ul>
      <form class="buscador" method="get" action={`${base}buscar/`} role="search">
        <label class="visualmente-oculto" for="buscar-catalogo">Buscar en el catálogo</label>
        <input
          id="buscar-catalogo"
          name="q"
          type="search"
          maxlength="80"
          autocomplete="off"
          enterkeyhint="search"
          placeholder="Buscar guías por texto…"
        />
        <button type="submit" class="boton--premium">Buscar</button>
      </form>
    </div>

    {!hayFiltros && recientes.length > 0 && (
      <section class="seccion" aria-labelledby="destacadas-titulo">
        <div class="seccion__cabecera">
          <h2 class="seccion__titulo" id="destacadas-titulo">Destacadas</h2>
        </div>
        <ul class="rejilla-tarjetas">
          {recientes.map((guia) => (
            <li><TarjetaGuia guia={guia} /></li>
          ))}
        </ul>
      </section>
    )}

    <p class="paginacion__estado" role="status">
      {total > 0
        ? plural(total, 'guía encontrada', 'guías encontradas')
        : 'Sin resultados para estos filtros.'}
    </p>

    <ul class="chips-rapidos" aria-label="Filtros rápidos">
      <li><a class="chip-filtro" href={enlaceCon({ equipo: equipo === 'red' ? '' : 'red', pagina: 1 })} aria-current={equipo === 'red' ? 'true' : undefined}>RED</a></li>
      <li><a class="chip-filtro" href={enlaceCon({ equipo: equipo === 'blue' ? '' : 'blue', pagina: 1 })} aria-current={equipo === 'blue' ? 'true' : undefined}>BLUE</a></li>
      <li><a class="chip-filtro" href={enlaceCon({ acceso: acceso === 'gratis' ? '' : 'gratis', pagina: 1 })} aria-current={acceso === 'gratis' ? 'true' : undefined}>Gratis</a></li>
      <li><a class="chip-filtro" href={enlaceCon({ acceso: acceso === 'pago' ? '' : 'pago', pagina: 1 })} aria-current={acceso === 'pago' ? 'true' : undefined}>Premium</a></li>
    </ul>

    <details class="filtros-detalle" open={Boolean(nivel || herramienta)}>
      <summary>Más filtros</summary>
      <ul class="chips-rapidos" aria-label="Filtrar por nivel">
        <li><a class="chip-filtro" href={enlaceCon({ nivel: nivel === 'basico' ? '' : 'basico', pagina: 1 })} aria-current={nivel === 'basico' ? 'true' : undefined}>Básico</a></li>
        <li><a class="chip-filtro" href={enlaceCon({ nivel: nivel === 'intermedio' ? '' : 'intermedio', pagina: 1 })} aria-current={nivel === 'intermedio' ? 'true' : undefined}>Intermedio</a></li>
        <li><a class="chip-filtro" href={enlaceCon({ nivel: nivel === 'avanzado' ? '' : 'avanzado', pagina: 1 })} aria-current={nivel === 'avanzado' ? 'true' : undefined}>Avanzado</a></li>
      </ul>
      <form class="filtros" method="get" action={`${base}guias/`} aria-labelledby="filtros-titulo">
        <h2 class="visualmente-oculto" id="filtros-titulo">Filtrar por herramienta</h2>
        {equipo && <input type="hidden" name="equipo" value={equipo} />}
        {nivel && <input type="hidden" name="nivel" value={nivel} />}
        {acceso && <input type="hidden" name="acceso" value={acceso} />}
        <div class="filtros__campo">
          <label for="filtro-herramienta">Herramienta</label>
          <select id="filtro-herramienta" name="herramienta">
            <option value="">Todas</option>
            {herramientas.map((item) => (
              <option value={item.herramienta} selected={item.herramienta === herramienta}>
                {nombreHerramienta(item.herramienta)} ({item.total})
              </option>
            ))}
          </select>
        </div>
        <div class="filtros__acciones">
          <button type="submit" class="boton boton--secundario">Aplicar</button>
          {hayFiltros && <a class="filtros__limpiar" href={`${base}guias/`}>Limpiar</a>}
        </div>
      </form>
    </details>

    {guias.length > 0 ? (
      <>
        <ul class="rejilla-tarjetas">
          {guias.map((guia) => (
            <li><TarjetaGuia guia={guia} /></li>
          ))}
        </ul>

        {paginas > 1 && (
          <nav class="paginacion" aria-label="Paginación de guías">
            <p class="paginacion__estado">Página {paginaActual} de {paginas}</p>
            <div class="paginacion__enlaces">
              {paginaActual > 1
                ? <a class="boton boton--secundario" href={enlaceCon({ pagina: paginaActual - 1 })} rel="prev">← Anterior</a>
                : <span class="boton boton--secundario" aria-disabled="true">← Anterior</span>}
              {paginaActual < paginas
                ? <a class="boton boton--secundario" href={enlaceCon({ pagina: paginaActual + 1 })} rel="next">Siguiente →</a>
                : <span class="boton boton--secundario" aria-disabled="true">Siguiente →</span>}
            </div>
          </nav>
        )}
      </>
    ) : (
      <div class="vacio vacio--con-mascota">
        <AssistantMascot estado="sad" tamano="lg" decorativa />
        <div>
          <p>No encontramos guías con esa combinación de filtros.</p>
          <p><a class="boton" href={`${base}guias/`}>Ver todas las guías</a></p>
        </div>
      </div>
    )}
  </section>

  <AsistenteFlotante />
</Base>