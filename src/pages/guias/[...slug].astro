---
import Guia from '../../layouts/Guia.astro';
import AsistenteFlotante from '../../components/AsistenteFlotante.astro';
import TarjetaGuia from '../../components/TarjetaGuia.astro';
import { getDatabase, guiasRelacionadas, guiasVecinas, listarGuiasPublicadas, obtenerGuiaPorSlug } from '../../lib/db.js';
import { extraerIndice, markdownAHtml } from '../../lib/markdown.js';
import { descripcionDesdeMarkdown, dividirPreview, tiempoLectura } from '../../lib/utils/texto.js';
import { nombreHerramienta } from '../../lib/vocabulario.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

/**
 * Solo se usa en el build estático de Pages (la integración de config fuerza
 * `prerender = true` fuera de /admin y /api). En Cloudflare se ignora.
 */
export async function getStaticPaths() {
  const database = getDatabase(env);
  const { guias } = await listarGuiasPublicadas(database, { porPagina: 48 });
  return guias.map((fila) => ({ params: { slug: fila.slug } }));
}

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const parametroSlug = Astro.params.slug ?? '';
const slug = Array.isArray(parametroSlug) ? parametroSlug.join('/') : parametroSlug;
const database = getDatabase(env);
const guia = slug ? await obtenerGuiaPorSlug(database, slug, { publicadas: true }) : null;

if (!guia) Astro.response.status = 404;

/**
 * Límite de exposición (P0): en guías de pago el navegador recibe SOLO la
 * vista previa. El cuerpo completo vive únicamente en el servidor durante
 * esta petición: jamás se pasa a la plantilla ni a los metadatos.
 */
const esPago = guia?.acceso === 'pago';
const { preview: cuerpoVistaPrevia, resto: seccionesRestantes } =
  esPago && guia ? dividirPreview(guia.cuerpo_md) : { preview: guia?.cuerpo_md ?? '', resto: [] };
const cuerpoVisible = esPago ? cuerpoVistaPrevia : (guia?.cuerpo_md ?? '');

const html = guia ? markdownAHtml(cuerpoVisible) : '';
const indice = guia ? extraerIndice(cuerpoVisible) : [];
const [vecinas, relacionadas] = guia
  ? await Promise.all([guiasVecinas(database, guia), guiasRelacionadas(database, guia, 4)])
  : [{ anterior: null, siguiente: null }, []];

const origen = Astro.site ?? Astro.url.origin;
const jsonLd = guia
  ? {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: guia.titulo,
      description: descripcionDesdeMarkdown(cuerpoVisible),
      datePublished: guia.fecha,
      dateModified: guia.actualizado_en ?? guia.fecha,
      inLanguage: 'es-ES',
      proficiencyLevel: guia.nivel,
      isAccessibleForFree: guia.acceso === 'gratis',
      keywords: [nombreHerramienta(guia.herramienta), 'ciberseguridad', guia.equipo === 'blue' ? 'defensa' : 'ofensiva'],
      mainEntityOfPage: new URL(`${base}guias/${guia.slug}/`, origen).href,
      author: { '@type': 'Organization', name: 'JOANIX GUIDES' },
      publisher: { '@type': 'Organization', name: 'JOANIX GUIDES' },
    }
  : undefined;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=600');
---

{
  guia ? (
    <Guia
      titulo={guia.titulo}
      herramienta={nombreHerramienta(guia.herramienta)}
      herramientaSlug={guia.herramienta}
      equipo={guia.equipo}
      nivel={guia.nivel}
      acceso={guia.acceso}
      enlaceCompra={guia.enlace_compra}
      descripcion={descripcionDesdeMarkdown(cuerpoVisible)}
      fecha={guia.fecha}
      tiempoLectura={esPago ? (guia.lectura_min ?? tiempoLectura(cuerpoVisible)) : tiempoLectura(cuerpoVisible)}
      restoTitulos={seccionesRestantes}
      indice={indice}
      jsonLd={jsonLd}
    >
      <div class="markdown" set:html={html} />

      <nav class="guia__vecinas" aria-label="Navegación entre guías">
        {vecinas.anterior ? (
          <a class="guia__vecina" href={`${base}guias/${vecinas.anterior.slug}/`} rel="prev">
            <span class="guia__vecina-etiqueta">← Guía anterior</span>
            <span class="guia__vecina-titulo">{vecinas.anterior.titulo}</span>
          </a>
        ) : (
          <span />
        )}
        {vecinas.siguiente ? (
          <a class="guia__vecina guia__vecina--derecha" href={`${base}guias/${vecinas.siguiente.slug}/`} rel="next">
            <span class="guia__vecina-etiqueta">Guía siguiente →</span>
            <span class="guia__vecina-titulo">{vecinas.siguiente.titulo}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>

      {relacionadas.length > 0 && (
      <section class="seccion guia__relacionadas" aria-labelledby="relacionadas-titulo">
        <div class="seccion__cabecera">
          <h2 class="seccion__titulo" id="relacionadas-titulo">
            Continúa aprendiendo
          </h2>
            <a href={`${base}herramientas/${guia.herramienta}/`}>Ver todo sobre {nombreHerramienta(guia.herramienta)}</a>
          </div>
          <ul class="rejilla-tarjetas">
            {relacionadas.map((otra) => (
              <li>
                <TarjetaGuia guia={otra} mostrarNivel={false} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </Guia>
  ) : (
    <Guia
      titulo="Guía no encontrada"
      herramienta=""
      equipo="blue"
      nivel=""
      acceso="gratis"
      noindex
      descripcion="La guía solicitada no existe o todavía no está publicada."
    >
      <p>La guía que buscas no existe, no está publicada o ha cambiado de dirección.</p>
      <p>
        <a class="boton" href={`${base}guias/`}>Ver todas las guías</a>
        <a class="boton boton--secundario" href={`${base}buscar/`}>Buscar por texto</a>
      </p>
    </Guia>
  )
}

<AsistenteFlotante />