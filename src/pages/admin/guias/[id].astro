---
import AdminBase from '../../../layouts/AdminBase.astro';
import EditorGuia from '../../../components/admin/EditorGuia.astro';
import { getDatabase, listarHerramientasAdmin, obtenerGuiaPorId } from '../../../lib/db.js';
import { idValido } from '../../../lib/admin-api.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

const id = Astro.params.id;
if (!idValido(id)) {
  return Astro.redirect('/admin/guias/', 302);
}

const sesion = Astro.locals.admin;
const database = getDatabase(env);
const guia = await obtenerGuiaPorId(database, id);
if (!guia) {
  return Astro.redirect('/admin/guias/', 302);
}

const herramientas = await listarHerramientasAdmin(database);
---

<AdminBase title={`Editar ${guia.titulo} | JOANIX GUIDES`}>
  <slot name="page-title">{guia.titulo}</slot>

  <slot name="breadcrumbs">
    <li><a href="/admin/">Resumen</a></li>
    <li><a href="/admin/guias/">Guías</a></li>
    <li aria-current="page">{guia.titulo}</li>
  </slot>

  <div class="admin-content">
    <header class="admin-section__header">
      <div>
        <p class="admin-section__eyebrow">Biblioteca / Edición</p>
        <h1 class="admin-section__title">{guia.titulo}</h1>
        <p class="admin-section__nota"><code>{guia.slug}</code> · {guia.publicada ? 'Publicada' : 'Borrador'} · actualizada {guia.actualizado_en}</p>
      </div>
      <a class="admin-boton admin-boton--secondary" href={`/guias/${guia.slug}/`} target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <polyline points="15 3 21 3 21 9" />
          <line x1="10" y1="14" x2="21" y2="3" />
        </svg>
        Ver en el portal
      </a>
    </header>

    <EditorGuia
      guia={guia}
      csrf={sesion?.csrf ?? ''}
      endpoint={`/api/admin/guias/${guia.id}`}
      metodo="PUT"
      esAdmin={sesion?.usuario.rol === 'admin'}
      herramientas={herramientas}
      today={String(guia.fecha).slice(0, 10)}
      asistente={true}
    />
  </div>
</AdminBase>

<script>
  import '../../../scripts/editor-guia.js';
</script>