---
import AdminBase from '../../../layouts/AdminBase.astro';
import EditorGuia from '../../../components/admin/EditorGuia.astro';
import { getDatabase, listarHerramientasAdmin, obtenerGuiaPorId } from '../../../lib/db.js';
import { idValido } from '../../../lib/admin-api.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

const id = Astro.params.id;
if (!idValido(id)) {
  return Astro.redirect('/admin/guias/', 302);
}

const sesion = Astro.locals.admin;
const database = getDatabase(env);
const guia = await obtenerGuiaPorId(database, id);
if (!guia) {
  return Astro.redirect('/admin/guias/', 302);
}

const herramientas = await listarHerramientasAdmin(database);
---

<AdminBase title={`Editar ${guia.titulo} | JOANIX GUIDES`}>
  <div class="admin-office">
    <header class="admin-office__header">
      <div>
        <p class="admin-shell__marca"><strong>JOANIX GUIDES</strong> / CONTROL ROOM</p>
        <p class="admin-shell__eyebrow">Biblioteca / Edición</p>
        <h1>{guia.titulo}</h1>
        <p class="admin-shell__intro">
          <code>{guia.slug}</code> · {guia.publicada ? 'Publicada' : 'Borrador'} · actualizada {guia.actualizado_en}
        </p>
      </div>
      <a class="admin-office__salir" href={`/guias/${guia.slug}/`}>Ver en el portal</a>
    </header>

    <EditorGuia
      guia={guia}
      csrf={sesion?.csrf ?? ''}
      endpoint={`/api/admin/guias/${guia.id}`}
      metodo="PUT"
      esAdmin={sesion?.usuario.rol === 'admin'}
      herramientas={herramientas}
      today={String(guia.fecha).slice(0, 10)}
      asistente={true}
    />
  </div>
</AdminBase>

<script>
  import '../../../scripts/editor-guia.js';
</script>