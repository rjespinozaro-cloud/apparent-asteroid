---
import AdminBase from '../../layouts/AdminBase.astro';
import { crearSesion, claveIntento, claveIntentoIp, cookieSesion, limpiarIntentos, loginBloqueado, registrarIntentoFallido, verificarCredenciales } from '../../lib/auth.js';
import { getDatabase, obtenerUsuarioPorNombre, registrarAuditoria } from '../../lib/db.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

/** Mensaje único para cualquier fallo: nunca revela si el usuario existe. */
const ERROR_GENERICO = 'No se ha podido iniciar sesión. Revisa tus datos.';
const ERROR_BLOQUEADO = 'Demasiados intentos. Espera unos minutos antes de reintentar.';

let error = '';
let usuarioEnviado = '';

/** Aviso de cierre de la instalación, mostrado una sola vez tras el 303. */
const instalado = Astro.url.searchParams.get('instalado') === '1';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const usuario = String(datos.get('usuario') ?? '').trim().toLowerCase().slice(0, 40);
  const password = String(datos.get('password') ?? '').slice(0, 200);
  usuarioEnviado = usuario;
  const ip = Astro.request.headers.get('CF-Connecting-IP') ?? 'sin-ip';
  const clave = claveIntento(usuario, ip);
  const claveIp = claveIntentoIp(ip);
  const database = getDatabase(env);

  // El bloqueo por usuario+IP y el agregado por IP frenan tanto el ataque
  // dirigido a una cuenta como el barrido de cuentas desde una misma IP.
  if (await loginBloqueado(database, clave, claveIp)) {
    error = ERROR_BLOQUEADO;
  } else {
    const cuenta = await obtenerUsuarioPorNombre(database, usuario);
    // `verificarCredenciales` ejecuta PBKDF2 incluso si la cuenta no existe,
    // así que el tiempo de respuesta no permite enumerar usuarios.
    const valido = await verificarCredenciales(cuenta ? { ...cuenta, password } : null);

    if (!valido) {
      await Promise.all([registrarIntentoFallido(database, clave), registrarIntentoFallido(database, claveIp)]);
      // Se registra el intento fallido para poder revisar la actividad del panel.
      await registrarAuditoria(database, {
        usuarioId: cuenta?.id ?? null,
        accion: 'login_fallido',
        objeto: cuenta ? `usuario:${cuenta.usuario}` : `desconocido:${ip}`,
        detalle: 'Credenciales incorrectas',
      });
      error = ERROR_GENERICO;
    } else {
      await limpiarIntentos(database, clave, claveIp);
      const sesion = await crearSesion(database, cuenta);
      return new Response(null, {
        status: 303,
        headers: { Location: '/admin/', 'Set-Cookie': cookieSesion(sesion.token) },
      });
    }
  }
}
---

<AdminBase
  title="Acceso | JOANIX GUIDES"
  description="Acceso privado a la oficina de administración de JOANIX GUIDES."
  pageTitle="Iniciar sesión"
  crumbs={[{ label: 'Acceso' }]}
>
  <div class="admin-content admin-auth">
    <article class="admin-auth__panel" aria-labelledby="login-titulo">
      <p class="admin-auth__marca">JOANIX GUIDES / ADMIN · Acceso privado</p>
      <h1 class="admin-auth__title" id="login-titulo">Iniciar sesión</h1>
      <p class="admin-auth__intro">Gestiona las guías y herramientas desde el panel de control.</p>

      {instalado && <p class="admin-alerta admin-alerta--ok" role="status">Administrador creado. Ya puedes iniciar sesión.</p>}
      {error && <p class="admin-alerta admin-alerta--error" role="alert">{error}</p>}

      <form class="admin-form" method="post">
        <div class="admin-form__campo">
          <label for="usuario">Usuario</label>
          <input id="usuario" name="usuario" type="text" value={usuarioEnviado} autocomplete="username"
            spellcheck="false" autocapitalize="none" maxlength="40" required />
        </div>
        <div class="admin-form__campo">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required />
        </div>
        <div class="admin-form__actions">
          <button type="submit" class="admin-boton admin-boton--primary">Entrar</button>
        </div>
      </form>

      <a class="admin-boton admin-boton--plano admin-auth__volver" href="/">Volver al portal público</a>
    </article>
  </div>
</AdminBase>