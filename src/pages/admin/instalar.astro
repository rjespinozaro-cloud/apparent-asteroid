---
import AdminBase from '../../layouts/AdminBase.astro';
import { claveIntentoIp, hashPassword, limpiarIntentos, loginBloqueado, registrarIntentoFallido, secretoValido } from '../../lib/auth.js';
import { contarUsuarios, crearUsuario, getDatabase, registrarAuditoria } from '../../lib/db.js';
import { MIN_PASSWORD } from '../../lib/validar.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

const ERROR_GENERICO = 'No se ha podido completar la instalación. Revisa los datos.';
const ERROR_BLOQUEADO = 'Demasiados intentos desde esta conexión. Espera unos minutos.';

let error = '';
const database = getDatabase(env);
const existeAdministrador = (await contarUsuarios(database)) > 0;

// Una vez existe un administrador la ruta desaparece, así que el riesgo real es
// el de intentar adivinar el token de arranque desde antes de instalarlo. Por eso
// el intento se limita por IP con la misma tabla que usa el login.
const ip = Astro.request.headers.get('CF-Connecting-IP') ?? 'sin-ip';
const claveIp = claveIntentoIp(`instalar:${ip}`);

if (Astro.request.method === 'POST' && !existeAdministrador) {
  const datos = await Astro.request.formData();
  const token = String(datos.get('token') ?? '').slice(0, 500);
  const usuario = String(datos.get('usuario') ?? '').trim().toLowerCase().slice(0, 40);
  const password = String(datos.get('password') ?? '').slice(0, 200);
  const bootstrap = env.ADMIN_BOOTSTRAP_TOKEN;

  if (await loginBloqueado(database, claveIp)) {
    error = ERROR_BLOQUEADO;
  } else {
    const usuarioValido = /^[a-z0-9._-]{3,40}$/.test(usuario);
    // Comparación en tiempo constante contra el token secreto del despliegue.
    const tokenValido = bootstrap ? await secretoValido(token, bootstrap) : false;

    if (!tokenValido || !usuarioValido || password.length < MIN_PASSWORD) {
      await registrarIntentoFallido(database, claveIp);
      error = ERROR_GENERICO;
    } else {
      await limpiarIntentos(database, claveIp);
      const credenciales = await hashPassword(password);
      await crearUsuario(database, { usuario, rol: 'admin', ...credenciales });
      await registrarAuditoria(database, {
        accion: 'crear',
        objeto: 'usuario',
        detalle: `Administrador inicial: ${usuario}`,
      });
      // Tras crear el administrador la instalación se cierra: se manda al login
      // en lugar de dejar el formulario montado otra vez en la misma respuesta.
      return new Response(null, { status: 303, headers: { Location: '/admin/login?instalado=1' } });
    }
  }
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<AdminBase title="Instalar | JOANIX GUIDES" description="Configuración inicial de JOANIX GUIDES.">
  <article class="admin-shell__panel" aria-labelledby="instalar-titulo">
    <p class="admin-shell__marca"><strong>JOANIX GUIDES</strong> / SETUP</p>
    <p class="admin-shell__eyebrow">Configuración inicial</p>
    <h1 id="instalar-titulo">Crear administrador</h1>

    {existeAdministrador ? (
      <p class="admin-alerta admin-alerta--ok" role="status">
        La instalación inicial ya se ha completado. <a href="/admin/login">Inicia sesión</a>.
      </p>
    ) : (
      <>
        <p class="admin-shell__intro">Crea el primer acceso seguro. Esta página se desactiva en cuanto exista un administrador.</p>
        {error && <p class="admin-alerta" role="alert">{error}</p>}
        <form class="admin-form" method="post">
          <div class="admin-form__campo">
            <label for="token">Token de instalación</label>
            <input id="token" name="token" type="password" autocomplete="off" maxlength="500" required />
          </div>
          <div class="admin-form__campo">
            <label for="usuario">Usuario</label>
            <input id="usuario" name="usuario" type="text" autocomplete="username" spellcheck="false"
              autocapitalize="none" maxlength="40" required />
          </div>
          <div class="admin-form__campo">
            <label for="password">Contraseña (mínimo {MIN_PASSWORD} caracteres)</label>
            <input id="password" name="password" type="password" autocomplete="new-password"
              minlength={MIN_PASSWORD} maxlength="200" required />
          </div>
          <button type="submit">Crear administrador</button>
        </form>
      </>
    )}
  </article>
</AdminBase>