---
import AdminBase from '../../layouts/AdminBase.astro';
import { env } from 'cloudflare:workers';
import { getDatabase, metricasVentasAdmin, obtenerEstadisticasAdmin, obtenerResumenMetricas } from '../../lib/db.js';
import { esAdmin as esAdminSesion } from '../../lib/roles.js';
import { formatearDinero, formatearFechaHora } from '../../lib/utils/texto.js';

export const prerender = false;

const sesion = Astro.locals.admin;
const esAdmin = esAdminSesion(sesion);
const database = getDatabase(env);
// Los datos de usuarios, IA y auditoría solo se consultan con rol admin.
const [stats, visitas, ventas] = await Promise.all([
  obtenerEstadisticasAdmin(database, { admin: esAdmin }),
  obtenerResumenMetricas(database, 30),
  esAdmin
    ? metricasVentasAdmin(database)
    : Promise.resolve({ totalVentas: 0, ingresosTotales: 0, completadas: 0, reembolsadas: 0 }),
]);

const { guias, usuarios, ia, auditoria, graficas } = stats;

const redPct = guias.total > 0 ? Math.round((guias.red / guias.total) * 100) : 0;
const bluePct = guias.total > 0 ? Math.round((guias.blue / guias.total) * 100) : 0;

const maxPorMes = Math.max(...graficas.por_mes.map((m) => m.total), 1);
const maxPorHerramienta = Math.max(...graficas.por_herramienta.map((h) => h.total), 1);
const maxUltimos30 = Math.max(...graficas.ultimos_30_dias.map((d) => d.total), 1);

// Donut RED/BLUE: circunferencia r=70 -> 2*pi*70 ~= 439.823.
// El segundo arco se desplaza con stroke-dashoffset = -longitud del primero.
const DONUT_C = 2 * Math.PI * 70;
const blueLen = (bluePct / 100) * DONUT_C;
const redLen = (redPct / 100) * DONUT_C;

// Visitas: serie completa de 30 días (incluye los días sin tráfico) y niveles
// discretos para dibujar las barras con clases CSS, sin estilos inline (CSP).
const conteoPorFecha = new Map(visitas.porFecha.map((dia) => [dia.fecha, dia.total]));
const serieVisitas = Array.from({ length: 30 }, (_, indice) => {
  const fecha = new Date(Date.now() - (29 - indice) * 86_400_000).toISOString().slice(0, 10);
  return { fecha, total: conteoPorFecha.get(fecha) ?? 0 };
});
const maxVisitasDia = Math.max(...serieVisitas.map((dia) => dia.total), 1);
const nivelVisita = (total: number): number => (
  total === 0 ? 0 : Math.max(1, Math.ceil((total / maxVisitasDia) * 10))
);

const NOMBRES_TIPO_VISITA: Record<string, string> = {
  portada: 'Portada',
  catalogo: 'Catálogo',
  guia: 'Guías',
  ruta: 'Rutas',
  herramienta: 'Herramientas',
  buscar: 'Búsqueda',
};
---

<AdminBase
  title="Resumen | JOANIX"
  pageTitle="Resumen"
  crumbs={[{ href: '/admin/', label: 'Resumen' }]}
>
  <div class="admin-content">
    <h1 class="visualmente-oculto">Resumen</h1>

    <!-- KPI Cards (Stripe / Shopify style) -->
    <section class="admin-kpi-grid" aria-label="Indicadores de catálogo y tienda">
      <article class="admin-kpi">
        <header class="admin-kpi__header">
          <span class="admin-kpi__label">Catálogo total</span>
          <span class="admin-kpi__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
            </svg>
          </span>
        </header>
        <p class="admin-kpi__value">{guias.total}</p>
        <p class="admin-kpi__subtext">
          <span class="admin-badge admin-badge--green">Activo</span>
          <span>Productos registrados</span>
        </p>
      </article>

      <article class="admin-kpi">
        <header class="admin-kpi__header">
          <span class="admin-kpi__label">Publicadas</span>
          <span class="admin-kpi__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
        </header>
        <p class="admin-kpi__value">{guias.publicadas}</p>
        <p class="admin-kpi__subtext">
          <span class="admin-badge admin-badge--green">Visibles</span>
          <span>En portal público</span>
        </p>
      </article>

      <article class="admin-kpi">
        <header class="admin-kpi__header">
          <span class="admin-kpi__label">Borradores</span>
          <span class="admin-kpi__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
          </span>
        </header>
        <p class="admin-kpi__value">{guias.borradores}</p>
        <p class="admin-kpi__subtext">
          <span class="admin-badge admin-badge--yellow">En edición</span>
          <span>Sin publicar</span>
        </p>
      </article>

      <article class="admin-kpi">
        <header class="admin-kpi__header">
          <span class="admin-kpi__label">Tienda / De pago</span>
          <span class="admin-kpi__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <line x1="2" y1="10" x2="22" y2="10" />
            </svg>
          </span>
        </header>
        <p class="admin-kpi__value">{guias.pago}</p>
        <p class="admin-kpi__subtext">
          <span class="admin-badge admin-badge--pago">PDF Comercial</span>
          <span>Paywall activo</span>
        </p>
      </article>

      {esAdmin && (
        <article class="admin-kpi">
          <header class="admin-kpi__header">
            <span class="admin-kpi__label">Ingresos tienda</span>
            <span class="admin-kpi__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
            </span>
          </header>
          <p class="admin-kpi__value">{formatearDinero(ventas.ingresosTotales)}</p>
          <p class="admin-kpi__subtext">
            <span class="admin-badge admin-badge--green">{ventas.completadas} venta{ventas.completadas === 1 ? '' : 's'}</span>
            <span>Completadas</span>
          </p>
        </article>
      )}

      <article class="admin-kpi">
        <header class="admin-kpi__header">
          <span class="admin-kpi__label">Acceso libre</span>
          <span class="admin-kpi__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </span>
        </header>
        <p class="admin-kpi__value">{guias.gratis}</p>
        <p class="admin-kpi__subtext">
          <span class="admin-badge admin-badge--gratis">Gratis</span>
          <span>Abiertas</span>
        </p>
      </article>

      <article class="admin-kpi">
        <header class="admin-kpi__header">
          <span class="admin-kpi__label">RED vs BLUE</span>
          <span class="admin-kpi__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a10 10 0 0 0 0 20z" />
            </svg>
          </span>
        </header>
        <p class="admin-kpi__value">{guias.red} <span class="admin-kpi__separador">/</span> {guias.blue}</p>
        <p class="admin-kpi__subtext">
          <span class="admin-badge admin-badge--red">{redPct}% RED</span>
          <span class="admin-badge admin-badge--blue">{bluePct}% BLUE</span>
        </p>
      </article>

      {esAdmin && (
        <>
          <article class="admin-kpi">
            <header class="admin-kpi__header">
              <span class="admin-kpi__label">Equipo de gestión</span>
              <span class="admin-kpi__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                </svg>
              </span>
            </header>
            <p class="admin-kpi__value">{usuarios.total}</p>
            <p class="admin-kpi__subtext">
              <span class="admin-badge admin-badge--green">{usuarios.activos} activos</span>
              <span>{usuarios.admins} admins</span>
            </p>
          </article>

          <article class="admin-kpi">
            <header class="admin-kpi__header">
              <span class="admin-kpi__label">Consumo IA</span>
              <span class="admin-kpi__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 6v6l4 2" />
                </svg>
              </span>
            </header>
            <p class="admin-kpi__value">{ia.llamadas}</p>
            <p class="admin-kpi__subtext">
              <span class="admin-badge admin-badge--pago">Llamadas mes</span>
              <span>{ia.tope_mensual > 0 ? `Tope: ${ia.tope_mensual.toLocaleString('es-ES')}` : 'Sin tope'}</span>
            </p>
          </article>
        </>
      )}
    </section>

    <!-- Charts Row 1: Por mes + Donut RED/BLUE -->
    <div class="admin-grid admin-grid--2">
      <section class="admin-chart admin-panel" aria-labelledby="chart-mes-title">
        <header class="admin-chart__header">
          <h2 id="chart-mes-title" class="admin-chart__title">Guías creadas por mes</h2>
          <span class="admin-chart__period">Últimos 6 meses</span>
        </header>
        {graficas.por_mes.length > 0 ? (
          <svg class="admin-chart__svg admin-bar-chart" viewBox="0 0 520 220" role="img" aria-label={`Gráfico de barras: guías creadas por mes. ${graficas.por_mes.map((m) => `${m.mes}: ${m.total} guías (${m.red} RED, ${m.blue} BLUE)`).join(', ')}`}>
            <defs>
              <linearGradient id="grad-blue" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--adm-blue)" />
                <stop offset="100%" stop-color="var(--adm-accent)" stop-opacity="0.7" />
              </linearGradient>
              <linearGradient id="grad-red" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--adm-red)" />
                <stop offset="100%" stop-color="var(--adm-red)" stop-opacity="0.6" />
              </linearGradient>
            </defs>
            <desc>Barras agrupadas por mes. Eje X: mes. Eje Y: número de guías.</desc>
            {/* Grid lines */}
            {[0.25, 0.5, 0.75, 1].map((t) => (
              <line class="admin-bar-chart__grid" x1="52" y1={180 - t * 145} x2="510" y2={180 - t * 145} />
            ))}
            {/* Y axis */}
            <line class="admin-bar-chart__axis" x1="52" y1="35" x2="52" y2="183" />
            <text class="admin-bar-chart__label" x="46" y="36" text-anchor="end" dominant-baseline="middle">{maxPorMes}</text>
            <text class="admin-bar-chart__label" x="46" y="107" text-anchor="end" dominant-baseline="middle">{Math.round(maxPorMes / 2)}</text>
            <text class="admin-bar-chart__label" x="46" y="180" text-anchor="end" dominant-baseline="middle">0</text>
            {/* Bars */}
            <g>
              {graficas.por_mes.map((m, i) => {
                const x = 70 + i * 75;
                const barWidth = 26;
                const redH  = maxPorMes > 0 ? (m.red  / maxPorMes) * 145 : 0;
                const blueH = maxPorMes > 0 ? (m.blue / maxPorMes) * 145 : 0;
                const yBase = 180;
                return (
                  <g>
                    <rect class="admin-bar-chart__bar" x={x} y={yBase - blueH} width={barWidth} height={Math.max(blueH,2)} fill="url(#grad-blue)" rx="3" />
                    {m.blue > 0 && <text class="admin-bar-chart__value" x={x + barWidth / 2} y={yBase - blueH - 5}>{m.blue}</text>}
                    <rect class="admin-bar-chart__bar" x={x + barWidth + 3} y={yBase - redH}  width={barWidth} height={Math.max(redH,2)}  fill="url(#grad-red)"  rx="3" />
                    {m.red > 0 && <text class="admin-bar-chart__value" x={x + barWidth + 3 + barWidth / 2} y={yBase - redH - 5}>{m.red}</text>}
                    <text class="admin-bar-chart__label" x={x + barWidth + 1} y={yBase + 14} text-anchor="middle">{m.mes.slice(5)}</text>
                  </g>
                );
              })}
            </g>
            {/* Legend */}
            <g transform="translate(60, 12)">
              <rect width="10" height="10" rx="2" fill="url(#grad-blue)" />
              <text x="14" y="9" font-size="10" fill="var(--adm-text-muted)">BLUE</text>
              <rect x="58" width="10" height="10" rx="2" fill="url(#grad-red)" />
              <text x="72" y="9" font-size="10" fill="var(--adm-text-muted)">RED</text>
            </g>
          </svg>
        ) : (
          <p class="admin-chart__empty"><span class="admin-chart__empty-icon">📊</span>No hay datos de guías por mes.</p>
        )}
      </section>

      <section class="admin-chart admin-panel" aria-labelledby="chart-redblue-title">
        <header class="admin-chart__header">
          <h2 id="chart-redblue-title" class="admin-chart__title">Reparto RED / BLUE</h2>
        </header>
        {guias.total > 0 ? (
          <>
            <svg class="admin-chart__svg admin-donut-chart" viewBox="0 0 200 200" role="img" aria-label={`Gráfico de dona: ${bluePct}% BLUE (${guias.blue} guías), ${redPct}% RED (${guias.red} guías)`}>
              <defs>
                <linearGradient id="grad-donut-blue" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="var(--adm-blue)" />
                  <stop offset="100%" stop-color="var(--adm-accent)" />
                </linearGradient>
              </defs>
              <desc>Dona con dos segmentos. Azul = equipo BLUE, rojo = equipo RED.</desc>
              {/* Track */}
              <circle class="admin-donut-chart__track" cx="100" cy="100" r="70" stroke-width="28" />
              {/* BLUE slice */}
              <circle
                cx="100" cy="100" r="70"
                stroke="url(#grad-donut-blue)"
                stroke-width="30"
                fill="none"
                stroke-dasharray={`${blueLen} ${DONUT_C}`}
                stroke-linecap="round"
                transform="rotate(-90 100 100)"
                class="admin-donut-chart__slice"
              />
              {/* RED slice */}
              <circle
                cx="100" cy="100" r="70"
                stroke="var(--adm-red)"
                stroke-width="30"
                fill="none"
                stroke-dasharray={`${redLen} ${DONUT_C}`}
                stroke-dashoffset={-blueLen}
                stroke-linecap="round"
                transform="rotate(-90 100 100)"
                class="admin-donut-chart__slice"
              />
              <g class="admin-donut-chart__center">
                <text class="admin-donut-chart__total" x="100" y="93">{guias.total}</text>
                <text class="admin-donut-chart__total-label" x="100" y="115">guías totales</text>
              </g>
            </svg>
            <div class="admin-chart__legend">
              <span class="admin-chart__legend-item">
                <span class="admin-chart__legend-color admin-chart__legend-color--blue"></span>
                BLUE: {guias.blue} ({bluePct}%)
              </span>
              <span class="admin-chart__legend-item">
                <span class="admin-chart__legend-color admin-chart__legend-color--red"></span>
                RED: {guias.red} ({redPct}%)
              </span>
            </div>
          </>
        ) : (
          <p class="admin-chart__empty"><span class="admin-chart__empty-icon">🍩</span>No hay guías para mostrar el reparto.</p>
        )}
      </section>
    </div>

    <!-- Charts Row 2: Top 5 herramientas + Auditoría 30 días -->
    <div class="admin-grid admin-grid--2">
      <section class="admin-chart admin-panel" aria-labelledby="chart-herramientas-title">
        <header class="admin-chart__header">
          <h2 id="chart-herramientas-title" class="admin-chart__title">Top herramientas</h2>
          <span class="admin-chart__period">Por nº de guías</span>
        </header>
        {graficas.por_herramienta.length > 0 ? (
          <svg class="admin-chart__svg admin-hbar-chart" viewBox="0 0 480 200" role="img" aria-label={`Barras horizontales: ${graficas.por_herramienta.map((h) => `${h.herramienta}: ${h.total}`).join(', ')}`}>
            <defs>
              <linearGradient id="grad-hbar" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--adm-accent)" />
                <stop offset="100%" stop-color="var(--adm-blue)" stop-opacity="0.7" />
              </linearGradient>
            </defs>
            <desc>Barras horizontales ordenadas de mayor a menor.</desc>
            <g>
              {graficas.por_herramienta.map((h, i) => {
                const y = 20 + i * 35;
                const trackW = 340;
                const barW = maxPorHerramienta > 0 ? (h.total / maxPorHerramienta) * trackW : 2;
                return (
                  <g>
                    <rect class="admin-hbar-chart__track" x={128} y={y} width={trackW} height={22} rx="4" />
                    <rect class="admin-hbar-chart__bar" x={128} y={y} width={Math.max(barW, 4)} height={22} fill="url(#grad-hbar)" rx="4" />
                    <text class="admin-hbar-chart__label" x={122} y={y + 14}>{h.herramienta.length > 16 ? h.herramienta.slice(0, 16) + '…' : h.herramienta}</text>
                    <text class="admin-hbar-chart__value" x={128 + Math.max(barW, 4) + 8} y={y + 14}>{h.total}</text>
                  </g>
                );
              })}
            </g>
          </svg>
        ) : (
          <p class="admin-chart__empty"><span class="admin-chart__empty-icon">🔧</span>No hay herramientas con guías.</p>
        )}
      </section>

      {esAdmin && (
        <section class="admin-chart admin-panel" aria-labelledby="chart-auditoria-title">
          <header class="admin-chart__header">
            <h2 id="chart-auditoria-title" class="admin-chart__title">Actividad auditoría</h2>
            <span class="admin-chart__period">Últimos 30 días</span>
          </header>
          {graficas.ultimos_30_dias.length > 0 ? (
            <svg class="admin-chart__svg admin-line-chart" viewBox="0 0 520 120" role="img" aria-label={`Línea de actividad: ${graficas.ultimos_30_dias.map((d) => `${d.dia}: ${d.total}`).join(', ')}`}>
              <defs>
                <linearGradient id="grad-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--adm-accent)" stop-opacity="0.5" />
                  <stop offset="100%" stop-color="var(--adm-accent)" stop-opacity="0" />
                </linearGradient>
              </defs>
              <desc>Gráfico de área temporal. Eje X: día. Eje Y: número de acciones.</desc>
              {/* Grid */}
              {[0.25, 0.5, 0.75].map((t) => (
                <line class="admin-line-chart__grid" x1="40" y1={90 - t * 70} x2="510" y2={90 - t * 70} />
              ))}
              {/* Area fill */}
              <path
                class="admin-line-chart__area"
                fill="url(#grad-area)"
                d={(() => {
                  const pts = graficas.ultimos_30_dias;
                  const n   = Math.max(pts.length - 1, 1);
                  const xs  = pts.map((_, i) => 40 + i * (470 / n));
                  const ys  = pts.map((d) => 90 - (maxUltimos30 > 0 ? d.total / maxUltimos30 : 0) * 70);
                  return `M${xs[0]},${ys[0]} ${xs.map((x, i) => `L${x},${ys[i]}`).join(' ')} L${xs[pts.length-1]},90 L${xs[0]},90 Z`;
                })()}
              />
              {/* Line */}
              <path
                class="admin-line-chart__line"
                stroke="var(--adm-accent)"
                d={(() => {
                  const pts = graficas.ultimos_30_dias;
                  const n   = Math.max(pts.length - 1, 1);
                  return `M${pts.map((d, i) => `${40 + i * (470/n)},${90 - (maxUltimos30>0?d.total/maxUltimos30:0)*70}`).join(' L')}`;
                })()}
              />
              {/* Points */}
              {graficas.ultimos_30_dias.map((d, i) => {
                const n = Math.max(graficas.ultimos_30_dias.length - 1, 1);
                const x = 40 + i * (470 / n);
                const y = 90 - (maxUltimos30 > 0 ? d.total / maxUltimos30 : 0) * 70;
                return <circle class="admin-line-chart__point" cx={x} cy={y} fill="var(--adm-accent)" />;
              })}
              {/* Y labels */}
              <text class="admin-bar-chart__label" x="36" y="22" text-anchor="end">{maxUltimos30}</text>
              <text class="admin-bar-chart__label" x="36" y="90" text-anchor="end">0</text>
            </svg>
          ) : (
            <p class="admin-chart__empty"><span class="admin-chart__empty-icon">📈</span>No hay actividad en los últimos 30 días.</p>
          )}
        </section>
      )}
    </div>

    <section class="admin-panel" aria-labelledby="visitas-title">
      <header class="admin-panel__header">
        <h2 id="visitas-title" class="admin-panel__titulo">Visitas · últimos 30 días</h2>
        <span class="admin-badge admin-badge--green">{visitas.totalVisitas.toLocaleString('es-ES')} visitas</span>
      </header>
      <div class="admin-panel__body">
        {visitas.totalVisitas > 0 ? (
          <>
            <div class="admin-visitas">
              <div class="admin-visitas__columna">
                <h3 class="admin-visitas__subtitulo">Por sección</h3>
                <ul class="admin-visitas__lista">
                  {visitas.porTipo.map((tipo) => (
                    <li class="admin-visitas__fila">
                      <span>{NOMBRES_TIPO_VISITA[tipo.ruta_tipo] ?? tipo.ruta_tipo}</span>
                      <strong>{tipo.total.toLocaleString('es-ES')}</strong>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="admin-visitas__columna">
                <h3 class="admin-visitas__subtitulo">Guías más leídas</h3>
                {visitas.topGuias.length > 0 ? (
                  <ol class="admin-visitas__lista admin-visitas__lista--ordenada">
                    {visitas.topGuias.map((guia) => (
                      <li class="admin-visitas__fila">
                        <span class="admin-visitas__slug">{guia.slug}</span>
                        <strong>{guia.total.toLocaleString('es-ES')}</strong>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <p class="admin-visitas__vacio">Todavía no hay lecturas registradas.</p>
                )}
              </div>
            </div>

            <div
              class="admin-visitas__grafico"
              role="img"
              aria-label={`Visitas por día de los últimos 30 días; máximo ${maxVisitasDia} en un día`}
            >
              {serieVisitas.map((dia) => (
                <span
                  class="admin-visitas__barra"
                  data-nivel={nivelVisita(dia.total)}
                  title={`${dia.fecha}: ${dia.total} visita${dia.total === 1 ? '' : 's'}`}
                />
              ))}
            </div>
            <p class="admin-panel__nota">
              Conteo anónimo y agregado por día: no se guardan IPs, cookies ni identificadores personales.
            </p>
          </>
        ) : (
          <p class="admin-panel__nota">
            Aún no hay visitas registradas. El contador es anónimo y agregado por día: no guarda IPs ni cookies.
          </p>
        )}
      </div>
    </section>

    <!-- Panels: Actividad reciente (solo admin), Pendientes, Acciones rápidas -->
    <div class="admin-grid admin-grid--2">
      {esAdmin && (
      <section class="admin-panel" aria-labelledby="actividad-title">
        <header class="admin-panel__header">
          <h2 id="actividad-title" class="admin-panel__titulo">Actividad reciente</h2>
          <a class="admin-boton admin-boton--plano" href="/admin/auditoria/">Ver todo</a>
        </header>
        <div class="admin-panel__body">
          {auditoria.ultimas.length > 0 ? (
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Objeto</th>
                  </tr>
                </thead>
                <tbody>
                  {auditoria.ultimas.map((registro) => (
                    <tr>
                      <td><time>{formatearFechaHora(registro.fecha)}</time></td>
                      <td>{registro.usuario ?? 'sistema'}</td>
                      <td><code>{registro.accion}</code></td>
                      <td><code>{registro.objeto}</code></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="admin-empty">Todavía no hay acciones registradas.</p>
          )}
        </div>
      </section>
      )}

      <section class="admin-panel" aria-labelledby="pendientes-title">
        <header class="admin-panel__header">
          <h2 id="pendientes-title" class="admin-panel__titulo">Pendientes</h2>
        </header>
        <div class="admin-panel__body">
          <ul class="admin-historial">
            {guias.borradores > 0 && (
              <li class="admin-historial__item">
                <p class="admin-historial__meta">
                  <span class="admin-badge admin-badge--yellow">{guias.borradores} borrador{guias.borradores === 1 ? '' : 'es'}</span>
                </p>
                <p>Guías sin publicar. <a class="admin-boton admin-boton--plano" href="/admin/guias/?estado=borrador">Revisar</a></p>
              </li>
            )}
            {esAdmin && usuarios.total > usuarios.activos && (
              <li class="admin-historial__item">
                <p class="admin-historial__meta">
                  <span class="admin-badge admin-badge--red">{usuarios.total - usuarios.activos} inactivo{usuarios.total - usuarios.activos === 1 ? '' : 's'}</span>
                </p>
                <p>Usuarios desactivados. <a class="admin-boton admin-boton--plano" href="/admin/usuarios/">Gestionar</a></p>
              </li>
            )}
            {esAdmin && ia.tope_mensual > 0 && ia.tokens_entrada + ia.tokens_salida > ia.tope_mensual * 0.8 && (
              <li class="admin-historial__item">
                <p class="admin-historial__meta">
                  <span class="admin-badge admin-badge--yellow">Consumo IA al {( (ia.tokens_entrada + ia.tokens_salida) / ia.tope_mensual * 100 ).toFixed(0)}%</span>
                </p>
                <p>Cerca del tope mensual. <a class="admin-boton admin-boton--plano" href="/admin/ajustes-ia/">Ajustar tope</a></p>
              </li>
            )}
            {!guias.borradores && !(esAdmin && usuarios.total > usuarios.activos) && !(esAdmin && ia.tope_mensual > 0 && ia.tokens_entrada + ia.tokens_salida > ia.tope_mensual * 0.8) && (
              <li class="admin-historial__item">
                <p class="admin-historial__meta"><span class="admin-badge admin-badge--green">Todo al día</span></p>
                <p>No hay elementos pendientes de revisión.</p>
              </li>
            )}
          </ul>
        </div>
      </section>
    </div>

    <section class="admin-panel" aria-labelledby="acciones-title">
      <header class="admin-panel__header">
        <h2 id="acciones-title" class="admin-panel__titulo">Acciones rápidas</h2>
      </header>
      <div class="admin-panel__body admin-acciones">
        <a class="admin-boton admin-boton--primary" href="/admin/guia-nueva/">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
          Nueva guía
        </a>
        <a class="admin-boton admin-boton--secondary" href="/admin/guias/">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          Ver guías
        </a>
        {esAdmin && (
          <>
            <a class="admin-boton admin-boton--secondary" href="/admin/usuarios/">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
              </svg>
              Gestionar usuarios
            </a>
            <a class="admin-boton admin-boton--secondary" href="/admin/ajustes-ia/">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 1 4.6 9a1.65 1.65 0 0 1 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 1-.33 1.82V9a1.65 1.65 0 0 1 1.51-1H9a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 1 1 1.51 1.65 1.65 0 0 1 1.82.33l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06.06a1.65 1.65 0 0 1-.33 1.82V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 1 1 1.51 1.65 1.65 0 0 1 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0-2.83l-.06-.06A1.65 1.65 0 0 1 15 4.6 1.65 1.65 0 0 1 16.5 3H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              Ajustes IA
            </a>
          </>
        )}
        <a class="admin-boton admin-boton--plano" href="/inicio/" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          Ver portal
        </a>
      </div>
    </section>

  </div>
</AdminBase>