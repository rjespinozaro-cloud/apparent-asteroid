---
import Base from '../../layouts/Base.astro';
import AsistenteFlotante from '../../components/AsistenteFlotante.astro';
import CabeceraCatalogo from '../../components/CabeceraCatalogo.astro';
import Migas from '../../components/Migas.astro';
import { getDatabase, listarGuiasDeHerramienta, listarHerramientasPublicadas } from '../../lib/db.js';
import { plural } from '../../lib/utils/texto.js';
import { nombreHerramienta } from '../../lib/vocabulario.js';
import { env } from 'cloudflare:workers';

export const prerender = false;

const database = getDatabase(env);
const herramientas = await listarHerramientasPublicadas(database);
const totalGuias = herramientas.reduce((suma, item) => suma + item.total, 0);
const totalRed = herramientas.reduce((suma, item) => suma + item.red, 0);
const totalBlue = herramientas.reduce((suma, item) => suma + item.blue, 0);
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
// Con una sola herramienta se muestran sus guías RED y BLUE directamente.
const unica = herramientas.length === 1 ? herramientas[0] : null;
const guiasUnica = unica ? await listarGuiasDeHerramienta(database, unica.herramienta) : [];
const rojasUnica = guiasUnica.filter((guia) => guia.equipo === 'red');
const azulesUnica = guiasUnica.filter((guia) => guia.equipo === 'blue');

const descripcion = herramientas.length > 0
  ? `${plural(herramientas.length, 'herramienta', 'herramientas')} con ${plural(totalGuias, 'guía', 'guías')} asociadas.`
  : 'Todavía no hay herramientas publicadas.';

const estadisticas = herramientas.length > 0
  ? [
      { value: herramientas.length, label: plural(herramientas.length, 'herramienta', 'herramientas'), tone: 'violet' as const },
      { value: totalGuias, label: plural(totalGuias, 'guía', 'guías'), tone: 'premium' as const },
      { value: totalRed, label: 'RED', tone: 'red' as const },
      { value: totalBlue, label: 'BLUE', tone: 'blue' as const },
    ].filter((stat) => stat.value > 0)
  : [];

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
---

<Base
  title="Herramientas | JOANIX GUIDES"
  description={`Explora las ${herramientas.length} herramientas documentadas en JOANIX GUIDES y encuentra las guías RED y BLUE de cada una.`}
  clase="catalogo-shell"
>
  <Migas clase="contenedor catalogo-migas" items={[{ texto: 'Inicio', href: `${base}inicio/` }, { texto: 'Herramientas' }]} />

  <section class="seccion catalogo-pagina catalogo-pagina--catalogo" aria-labelledby="herramientas-titulo">
    <CabeceraCatalogo
      title="Herramientas"
      titleId="herramientas-titulo"
      description={descripcion}
      searchId="buscar-herramientas"
      stats={estadisticas}
      statsLabel="Resumen de herramientas"
    />

    <p class="paginacion__estado" role="status">
      {herramientas.length > 0
        ? plural(herramientas.length, 'herramienta encontrada', 'herramientas encontradas')
        : 'Sin herramientas publicadas.'}
    </p>

    {
      unica ? (
        <article class="herramienta-detalle tarjeta-premium" aria-labelledby="herramienta-unica" data-spotlight>
          <p class="tarjeta__kicker tarjeta__kicker--neutro">Herramienta</p>
          <h2 class="tarjeta__titulo" id="herramienta-unica">{nombreHerramienta(unica.herramienta)}</h2>
          <p class="tarjeta__meta-linea">
            {plural(unica.total, 'guía', 'guías')} · {plural(unica.red, 'ofensiva', 'ofensivas')} (RED) · {plural(unica.blue, 'defensiva', 'defensivas')} (BLUE)
          </p>
          {rojasUnica.length > 0 && (
            <div class="herramienta-detalle__grupo">
              <p class="tarjeta__kicker tarjeta__kicker--red">RED · Ofensiva</p>
              <ul class="herramienta-detalle__guias">
                {rojasUnica.map((guia) => (
                  <li><a href={`${base}guias/${guia.slug}/`}>{guia.titulo}</a></li>
                ))}
              </ul>
            </div>
          )}
          {azulesUnica.length > 0 && (
            <div class="herramienta-detalle__grupo">
              <p class="tarjeta__kicker tarjeta__kicker--blue">BLUE · Defensa</p>
              <ul class="herramienta-detalle__guias">
                {azulesUnica.map((guia) => (
                  <li><a href={`${base}guias/${guia.slug}/`}>{guia.titulo}</a></li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ) : herramientas.length > 0 ? (
        <ul class="rejilla-tarjetas lista-herramientas--tarjetas reveal--stagger">
          {herramientas.map((item) => (
            <li>
              <article class="tarjeta-premium tarjeta--herramienta" data-spotlight>
                <p class="tarjeta__kicker tarjeta__kicker--neutro">Herramienta</p>
                <h2 class="tarjeta__titulo">
                  <a href={`${base}herramientas/${item.herramienta}/`}>{nombreHerramienta(item.herramienta)}</a>
                </h2>
                <p class="tarjeta__meta-linea">{plural(item.total, 'guía', 'guías')} asociadas</p>
                <p class="tarjeta__meta">
                  {item.blue > 0 && <span class="etiqueta etiqueta--blue">BLUE {item.blue}</span>}
                  {item.red > 0 && <span class="etiqueta etiqueta--red">RED {item.red}</span>}
                </p>
                <span class="tarjeta__accion" aria-hidden="true">Ver guías →</span>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <div class="vacio">
          <p>
            Aún no hay guías publicadas. Vuelve pronto o revisa el <a class="link--premium" href={`${base}guias/`}>catálogo</a>.
          </p>
        </div>
      )
    }
  </section>

  <AsistenteFlotante />
</Base>
